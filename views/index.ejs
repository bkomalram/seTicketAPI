      document
        .querySelector("#form-create-game")
        .addEventListener("submit", function (event) {
          event.preventDefault();
          document
            .querySelector("#spinner-create-game")
            .classList.remove("d-none");
          document.querySelector("#text-create-game").classList.add("d-none");
          document.querySelector("#error-create-game").innerHTML = "";
          document.querySelector("#success-create-game").innerHTML = "";
          if (document.querySelector("#inputName-create-game").value === "") {
            document
              .querySelector("#spinner-create-game")
              .classList.add("d-none");
            document
              .querySelector("#text-create-game")
              .classList.remove("d-none");
            document.querySelector("#error-create-game").innerHTML =
              "Se requiere el nombre del sorteo, para proceder.";
            return false;
          }

          var data = {
            usuarioId: localStorage.getItem("sesion-id"),
            nombreSorteo: document.querySelector("#inputName-create-game")
              .value,
          };
          fetch(api + "sorteo", {
            method: "POST",
            body: JSON.stringify(data),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                document
                  .querySelector("#spinner-create-game")
                  .classList.add("d-none");
                document
                  .querySelector("#text-create-game")
                  .classList.remove("d-none");
                document.querySelector("#success-create-game").innerHTML =
                  data.resultado.mensaje;
              } else {
                document.querySelector("#inputName-create-game").value = "";
                document.querySelector("#error-create-game").innerHTML =
                  data.resultado;
              }
              document
                .querySelector("#spinner-create-game")
                .classList.add("d-none");
              document
                .querySelector("#text-create-game")
                .classList.remove("d-none");
            })
            .then((data) => {
              cargarSorteos();
              document.querySelector("#inputName-create-game").value = "";
            });
        });

