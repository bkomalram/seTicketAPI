              <div class="col-12 card-border">Diferencia</div>
            </div>
            <div class="d-flex">
              <div class="col-4">Chance</div>
              <div class="offset-4 col-4" id="chanceBalanceTotal"></div>
            </div>
            <div class="d-flex">
              <div class="col-4">Billete</div>
              <div class="offset-4 col-4" id="BilleteBalanceTotal"></div>
