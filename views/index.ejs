      document.querySelector("#btnEditar")
      .addEventListener("click",function() {
        localStorage.removeItem("edit-ticket-number")
        bag.clear()
        //Traer el ticket de la BD
        if (isNaN(document.querySelector("#noOldTicket").value) || document.querySelector("#noOldTicket").value == ""){
          //Mensaje
          return
        }    
        fetch(api + "tiquete/"+document.querySelector("#noOldTicket").value+"?accion=editar", {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
          .then((response) => response.json())
          .then((data) => {
            if (data.resultado.length < 1) {
              /**
               * 
               * Removiendo transicion
               * */
              document
              .querySelector("#spinner-print-ticket")
              .classList.add("d-none");
                document
                  .querySelector("#text-print-ticket")
                  .classList.remove("d-none");
              /*
              * Agregar Modal
              * Mensaje no exitoso
              */
              document.querySelector("#text-error-ticket").innerHTML =
              "Recuerda solo puedes recargar ticketes que hayas vendido.";

              $("#modalErrorTicket").modal("show");

              return;
            }
            //Montarlo en la bolsa
            for (let editarIndex = 0; editarIndex < data.resultado.length; editarIndex++) {
              const element = data.resultado[editarIndex];
              let newItem = {
                number:"",
                qty:0,
                price:0,
                total:0
              }
              newItem.number = element.numero
              newItem.qty = element.cantidad
              newItem.price = element.tipo == "BILLETE" ? 1.00 : 0.25
              newItem.total = element.valorcompra      
              let indexItem = bag.items.findIndex(object=>object.number === newItem.number)
              
              if (indexItem>-1) {
                if (newItem.qty==0) {
                  bag.update(indexItem,newItem)
                } else {
                  bag.push(indexItem,newItem)
                }
              } else {
                if (newItem.qty>0) {
                  bag.add(newItem) 
                }                    
              }
            }

            // Cambiar numero
            globalChance.receiptCount = data.resultado[0].GameTicketId
            localStorage.setItem("edit-ticket-number",data.resultado[0].GameTicketId)
            bag.render()
            document.querySelector("#btnEditar").classList.add("d-none")
            document.querySelector("#btnAceptarEditar").classList.remove("d-none")
            document.querySelector("#btnEliminarEditar").classList.remove("d-none")

            //UX Mobile - Editar
            document.querySelector("#mobile-btn-kit-1").classList.add("d-none")
            document.querySelector("#mobile-btn-kit-2").classList.remove("d-none")
            document.querySelector("[name='mobile-edit-ticket']").classList.add("d-none")
            document.querySelector("[name='optional-customer-name-mobile']").classList.add("d-none")

            return data
          })
          .then((data) => {
            
          })
      })

