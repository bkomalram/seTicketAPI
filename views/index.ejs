                          type="button"
                          class="close"
                          data-dismiss="modal"
                          aria-label="Close"
                        >
                          <span aria-hidden="true">&times;</span>
                        </button>
                      </div>
                      <form id="form-config">
                        <div class="modal-body text-center">
                          <input type="text" id="inTicket" />
                        </div>
                        <div
                          class="modal-footer"
                          style="justify-content: center !important"
                        >
                          <button
                            type="submit"
                            class="btn btn-sm btn-secondary col-6"
                            id="btn-reedem-game"
                          >
                            Aceptar
                          </button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-6">
                <button
                  class="btn btn-sm btn-secondary col-12"
                  id="btn-bill-game"
                >
                  <h6 id="text-bill-game">Cuentas</h6>
                  <div
                    class="spinner-grow d-none"
                    role="status"
                    id="spinner-bill-game"
                  >
                    <span class="sr-only">Loading...</span>
                  </div>
                </button>
              </div>
            </div>
            <div class="row">
              <div class="col-6">
                <button
                  class="btn btn-sm btn-secondary col-12"
                  id="btn-close-game"
                >
                  <h6 id="text-close-game">Cerrar sorteo</h6>
                  <div
                    class="spinner-grow d-none"
                    role="status"
                    id="spinner-close-game"
                  >
                    <span class="sr-only">Loading...</span>
                  </div>
                </button>
              </div>
              <div class="col-6">
                <button
                  class="btn btn-sm btn-secondary col-12"
                  id="btn-balance-game"
                >
                  <h6 id="text-balance-game">Balances</h6>
                  <div
                    class="spinner-grow d-none"
                    role="status"
                    id="spinner-balance-game"
                  >
                    <span class="sr-only">Loading...</span>
                  </div>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-4">
        <div class="card-border">
          <div class="col-12 text-center mt-2" id="estadoTitulo">
            <h5>Crea un sorteo para empezar</h5>
          </div>
          <div class="d-flex" id="estado"></div>
        </div>
      </div>
      <div class="col-4">
        <div class="d-flex card-border" id="estadoSorteo">
          <div class="col-12 font-weight-bold my-2" id="totalSorteo">
            <div class="d-flex">
              <div class="offset-4 col-4">Cantidad</div>
              <div class="col-4">Monto</div>
            </div>
            <div class="d-flex">
              <div class="col-4">Chance</div>
              <div class="col-4" id="chanceCantidad"></div>
              <div class="col-4" id="chancePlata"></div>
            </div>
            <div class="d-flex">
              <div class="col-4">Billete</div>
              <div class="col-4" id="billeteCantidad"></div>
              <div class="col-4" id="billetePlata"></div>
            </div>
          </div>
        </div>
        <div class="d-flex" id="estadoBillete"></div>
      </div>
    </div>
    <div
      class="alert alert-danger d-none offset-4 col-4 mt-5 p-5"
      role="alert"
      id="alertSession"
    >
      <h4 class="alert-heading">Su sesión caduco!</h4>
      <p>Oh si! debes ingresar nuevamente</p>
      <hr />
      <p class="mb-0" id="txtTimer">Seras redireccionado en 2 segundos . . .</p>
    </div>
    <div
      class="d-flex justify-content-center"
      style="margin-top: 20%"
      id="loading"
    >
      <div
        class="spinner-grow"
        role="status"
        style="
          width: 10rem;
          height: 10rem;
          background-color: #dee2e6 !important;
        "
        id="spinnerLog"
      >
        <span class="sr-only">Loading...</span>
      </div>
    </div>

    <script src="/javascripts/qrcode.min.js"></script>
    <script src="/javascripts/modules/output.js"></script>
    <script src="/javascripts/renderer.js"></script>
    <script src="/javascripts/jquery-3.2.1.slim.min.js"></script>
    <script src="/javascripts/popper.min.js"></script>
    <script src="/javascripts/bootstrap.min.js"></script>
    <script>
      var api = "<%= enviroment.URL_API %>";
      var qrURL = "<%= enviroment.URL_QR %>";

      /*Verificar si tiene sesión*/
      if (localStorage.getItem("tokenSSO")) {
        /*Verificando token*/
        fetch(api + "usuarios/decode", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.exitoso) {
              /**
               * Basado en el perfil mostrar o dejar de mostrar
               */
              localStorage.setItem("sesion-accesos", data.resultado.accesos);
              localStorage.setItem("sesion-perfil", data.resultado.perfil);
              localStorage.setItem("sesion-usuario", data.resultado.usuario);
              localStorage.setItem("sesion-id", data.resultado.id);

              if (data.resultado.perfil != "ADMIN") {
                document
                  .querySelector("#contenedorConfiguracion")
                  .classList.add("d-none");
                document.querySelector("#btn-close-game").classList.add("d-none");
                /*document
                  .querySelector("#contenedorAccionesAdministrador")
                  .classList.add("d-none");*/
              }
              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#venta").classList.remove("d-none");
            } else {
              /**
               * Caduco la sesión mensaje y redireccionar
               */

              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#venta").classList.add("d-none");
              document
                .querySelector("#alertSession")
                .classList.remove("d-none");

              localStorage.removeItem("tokenSSO");
              setTimeout(function () {
                window.location = "/";
              }, 2000);
            }
          });
      } else {
        document.querySelector("#venta").classList.add("d-none");
        document.querySelector("#loading").classList.remove("d-flex");
        document.querySelector("#loading").classList.add("d-none");
        document.querySelector("#alertSession").classList.remove("d-none");
        localStorage.removeItem("tokenSSO");
        setTimeout(function () {
          window.location = "/";
        }, 2000);
      }

      /**
       * Carga automatica
       */

      /**
       * Datos de sorteos
       */
      cargarSorteos();

      function cargarSorteos() {
        fetch(api + "sorteo", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              document
                .querySelector("#form-set-config")
                .classList.remove("d-none");
              let select = document.querySelector("#select-choose-game");
              while (select.length > 0) {
                select.remove(select.length - 1);
              }
              data.resultado.forEach((element) => {
                let option = document.createElement("option");
                option.text = element.nombre;
                option.value = element.id;
                option.setAttribute("name", element.id);
                select.add(option);
              });
            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando sorteos, contacte el administrador.";
              document
                .querySelector("#form-set-config")
                .classList.add("d-none");
            }
            return;
          })
          .then((sorteo) => {
            if (localStorage.getItem("choose-game")) {
              document
                .querySelector("#select-choose-game")
                .setAttribute("disabled", true);
              document.querySelector("#select-choose-game").value =
                localStorage.getItem("choose-game");
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
            }
            return;
          })
          .then((titulo) => {
            if (localStorage.getItem("title-ticket")) {
              document.querySelector("#inputName-title-ticket").value =
                localStorage.getItem("title-ticket");
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
              document
                .querySelector("#inputName-title-ticket")
                .setAttribute("disabled", true);
            } else if (localStorage.getItem("choose-game")) {
              let autoTitle =
                document.querySelectorAll("#select-choose-game option")[
                  document.querySelector("#select-choose-game").selectedIndex
                ].text +
                "-" +
                localStorage.getItem("sesion-usuario");
              document.querySelector("#inputName-title-ticket").value =
                autoTitle;
              localStorage.setItem("title-ticket", autoTitle);
              document
                .querySelector("#inputName-title-ticket")
                .setAttribute("disabled", true);
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
            } else {
              document.querySelector("#inputName-title-ticket").value =
                "Sin titulo";
              document
                .querySelector("#inputName-title-ticket")
                .removeAttribute("disabled");
            }
            return;
          })
          .then((estado) => {
            cargarEstadoSorteo();
          });
      }

      /*Habilitando boton*/
      if (
        !localStorage.getItem("choose-game") &&
        !localStorage.getItem("title-ticket")
      ) {
        document.querySelector("#text-set-config").innerHTML = "Aceptar";
      }

      /**
       * Cargando estado de sorteo
       */
      function cargarEstadoSorteo() {
        let builder = document.querySelector("#estado");
        builder.innerHTML = "";

        let contenedorBillete = document.querySelector("div[id=estadoBillete]");
        contenedorBillete.innerHTML = "";

        document.querySelector("#chanceCantidad").innerHTML = 0;
        document.querySelector("#chancePlata").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);

        document.querySelector("#billeteCantidad").innerHTML = 0;
        document.querySelector("#billetePlata").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);

        document.querySelector("#estadoTitulo").innerHTML =
          "<h5>" +
          document.querySelectorAll("#select-choose-game option")[
            document.querySelector("#select-choose-game").selectedIndex
          ].text +
          "</h5>";

        let numeroSorteo = document.querySelectorAll(
          "#select-choose-game option"
        )[document.querySelector("#select-choose-game").selectedIndex].value;

        fetch(api + "sorteo/" + numeroSorteo + "/chances?ord=numero", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            let builderHTML = "";
            for (let index = 0; index < 100; index++) {
              let numeroTemporal = data.resultado.find(
                (elemento) => elemento.numero == index.toString().padStart(2, 0)
              );
              //console.table(numeroTemporal);
              var cantidadIterable = 0;
              if (numeroTemporal) {
                cantidadIterable = numeroTemporal.cantidad;
              }

              builderHTML +=
                '<div class="d-flex"><b class="mr-3">' +
                index.toString().padStart(2, 0) +
                "</b>" +
                '<p class="mb-0">' +
                cantidadIterable +
                "</p></div>";
              if ([24, 49, 74, 99].indexOf(Number(index)) > -1) {
                builder.innerHTML +=
                  '<div class="col-3 py-1">' + builderHTML + "</div>";
                builderHTML = "";
              }
            }
            return data.resultado;
          })
          .then((totales) => {
            let cantidadTotal = 0;
            let montoTotal = 0;
            totales.forEach((elemento) => {
              cantidadTotal = cantidadTotal + Number(elemento.cantidad);
              montoTotal = montoTotal + elemento.dineroVenta;
            });
            document.querySelector("#chanceCantidad").innerHTML =
              cantidadTotal || 0;
            document.querySelector("#chancePlata").innerHTML = (
              Math.round(montoTotal * 100) / 100
            ).toFixed(2);
          });

        /*Billetes*/
        fetch(api + "sorteo/" + numeroSorteo + "/billetes", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            contenedorBillete = document.querySelector("div[id=estadoBillete]");
            contenedorBillete.innerHTML = "";
            temporalHTML = "";
            var count = 0;
            var base =
              data.resultado.length < 20 ? data.resultado.length / 4 : 20;
            data.resultado.forEach((elemento) => {
              temporalHTML +=
                '<div class="d-flex"><b class="mr-3">' +
                elemento.numero +
                "</b>" +
                '<p class="mb-0">' +
                elemento.cantidad +
                "</p></div>";
              count += 1;
              if (count % base == 0) {
                contenedorBillete.innerHTML +=
                  '<div class="col-3 py-1">' + temporalHTML + "</div>";
                temporalHTML = "";
              }
            });
            return data.resultado;
          })
          .then((totales) => {
            let cantidadTotal = 0;
            let montoTotal = 0;
            totales.forEach((elemento) => {
              cantidadTotal = cantidadTotal + Number(elemento.cantidad);
              montoTotal = montoTotal + elemento.dineroVenta;
            });
            document.querySelector("#billeteCantidad").innerHTML =
              cantidadTotal || 0;
            document.querySelector("#billetePlata").innerHTML = (
              Math.round(montoTotal * 100) / 100
            ).toFixed(2);
          });
      }

      /**
       *
       *  Crear sorteo
       *
       * * */
      document
        .querySelector("#form-create-game")
        .addEventListener("submit", function (event) {
          event.preventDefault();
          document
            .querySelector("#spinner-create-game")
            .classList.remove("d-none");
          document.querySelector("#text-create-game").classList.add("d-none");
          document.querySelector("#error-create-game").innerHTML = "";
          document.querySelector("#success-create-game").innerHTML = "";
          if (document.querySelector("#inputName-create-game").value === "") {
            document
              .querySelector("#spinner-create-game")
              .classList.add("d-none");
            document
              .querySelector("#text-create-game")
              .classList.remove("d-none");
            document.querySelector("#error-create-game").innerHTML =
              "Se requiere el nombre del sorteo, para proceder.";
            return false;
          }

          var data = {
            usuarioId: localStorage.getItem("sesion-id"),
            nombreSorteo: document.querySelector("#inputName-create-game")
              .value,
          };
          fetch(api + "sorteo", {
            method: "POST",
            body: JSON.stringify(data),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                document
                  .querySelector("#spinner-create-game")
                  .classList.add("d-none");
                document
                  .querySelector("#text-create-game")
                  .classList.remove("d-none");
                document.querySelector("#success-create-game").innerHTML =
                  data.resultado.mensaje;
              } else {
                document.querySelector("#inputName-create-game").value = "";
                document.querySelector("#error-create-game").innerHTML =
                  data.resultado;
              }
              document
                .querySelector("#spinner-create-game")
                .classList.add("d-none");
              document
                .querySelector("#text-create-game")
                .classList.remove("d-none");
            })
            .then((data) => {
              cargarSorteos();
              document.querySelector("#inputName-create-game").value = "";
            });
        });

      /***
       * Cerrar Sorteo
       *
       */

      function cerrarSorteo() {
        var data = {
          sorteoId: localStorage.getItem("choose-game"),
        };

        fetch(api + "sorteo", {
          method: "PATCH",
          body: JSON.stringify(data),
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {})
          .finally(() => {});
      }

      document
        .querySelector("#btn-close-game")
        .addEventListener("click", function (event) {
          event.preventDefault();
          document.querySelector("#text-close-game").classList.add("d-none");
          document
            .querySelector("#spinner-close-game")
            .classList.remove("d-none");

          cerrarSorteo();

          document.querySelector("#text-close-game").classList.remove("d-none");
          document.querySelector("#spinner-close-game").classList.add("d-none");

          document.querySelector("#estadoTitulo").innerHTML =
            "<h5>Crea un sorteo para empezar</h5>";

          cargarSorteos();

          document
            .querySelector("#inputName-title-ticket")
            .removeAttribute("disabled");
          document
            .querySelector("#select-choose-game")
            .removeAttribute("disabled");

          let builder = document.querySelector("#estado");
          builder.innerHTML = "";

          document.querySelector("#chanceCantidad").innerHTML = 0;
          document.querySelector("#chancePlata").innerHTML = (
            Math.round(0 * 100) / 100
          ).toFixed(2);

          document.querySelector("#billeteCantidad").innerHTML = 0;
          document.querySelector("#billetePlata").innerHTML = (
            Math.round(0 * 100) / 100
          ).toFixed(2);
        });

      /**
       *
       * Actualiza el sorteo en venta
       *
       */
      document
        .querySelector("#btn-refresh-game")
        .addEventListener("click", function (event) {
          event.preventDefault();

          document.querySelector("#text-refresh-game").classList.add("d-none");
          document
            .querySelector("#spinner-refresh-game")
            .classList.remove("d-none");

          cargarEstadoSorteo();

          document
            .querySelector("#text-refresh-game")
            .classList.remove("d-none");
          document
            .querySelector("#spinner-refresh-game")
            .classList.add("d-none");
        });
      /**
       *
       * Cambiar configuracion
       *    Titulo del tiquete
       *    Sorteo en venta
       * * */

      document
        .querySelector("#form-set-config")
        .addEventListener("submit", function (event) {
          event.preventDefault();

          /**
           * Habilitar modificacion
           */
          let isTitle = document
            .querySelector("#inputName-title-ticket")
            .hasAttribute("disabled");
          let isGame = document
            .querySelector("#select-choose-game")
            .hasAttribute("disabled");
          if (isTitle || isGame) {
            document
              .querySelector("#inputName-title-ticket")
              .removeAttribute("disabled");
            document
              .querySelector("#select-choose-game")
              .removeAttribute("disabled");
            document.querySelector("#text-set-config").innerHTML = "Aceptar";
          } else {
            localStorage.setItem(
              "title-ticket",
              document.querySelector("#inputName-title-ticket").value
            );
            localStorage.setItem(
              "choose-game",
              document
                .querySelectorAll("#select-choose-game option")
                [
                  document.querySelector("#select-choose-game").selectedIndex
                ].getAttribute("name")
            );
            document
              .querySelector("#inputName-title-ticket")
              .setAttribute("disabled", true);
            document
              .querySelector("#select-choose-game")
              .setAttribute("disabled", true);
            document.querySelector("#text-set-config").innerHTML = "Modificar";

            bag.id();
            globalChance.person = localStorage.getItem("title-ticket");
            bag.render();
          }
        });

      /* *
       *
       * Utilidades de tablero
       *
       * */
      function limpiarTablero() {
        bag.clear();
        bag.calc();
        bag.render();
        globalChance.receiptCount = 0;
        document.querySelector("#search").value = "";
        document.querySelector("#iBillete").value = "";
        document.querySelector("#iBilleteQty").value = "";
        document.querySelectorAll("#chanceBuilder input").forEach((element) => {
          element.value = "";
        });
      }
      function imprimirTiquete(event) {
        document.querySelector("#text-print-ticket").classList.add("d-none");
        document
          .querySelector("#spinner-print-ticket")
          .classList.remove("d-none");
        document.querySelector("#text-error-ticket").innerHTML = "";

        if (!localStorage.getItem("choose-game")) {
          return;
        }
        if (!localStorage.getItem("title-ticket")) {
          return;
        }

        if (bag.items.length > 0) {
          var arregloRegistros = [];

          bag.items.forEach((element) => {
            var objetoRegistro = {
              tipo: null,
              numero: null,
              cantidad: null,
              valor: null,
              precio: null,
            };

            if (element.number.length == 2) objetoRegistro.tipo = "CHANCE";
            else objetoRegistro.tipo = "BILLETE";

            objetoRegistro.numero = element.number;
            objetoRegistro.cantidad = element.qty;
            objetoRegistro.valor = element.total;
            objetoRegistro.precio = element.price;

            arregloRegistros.push(objetoRegistro);
          });

          var objetoSorteo = {
            sorteoId: localStorage.getItem("choose-game"),
            valor: bag.total,
            registros: arregloRegistros,
          };

          fetch(api + "tiquete/mq", {
            method: "POST",
            body: JSON.stringify(objetoSorteo),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                globalChance.receiptCount = data.resultado.id;
                bag.render();
                document.querySelector("#outPut1").innerHTML =
                  document.querySelector("#ticketOutput").innerHTML +
                  "<div class='mt-4'></div>" +
                  document.querySelector("#ticketOutput").innerHTML +
                  "<div class='mt-2'></div>";
                generarQR(
                  qrURL + "cambiar?id=" + globalChance.receiptCount.toString()
                );
                window.print();
                limpiarTablero();
              } else {
                /*Agregar Modal
                 * Mensaje no exitoso
                 */
                document.querySelector("#text-error-ticket").innerHTML =
                  data.resultado;

                $("#modalErrorTicket").modal("show");
              }

              document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
            });
        }
      }

      /* *
       *
       * Tablero de venta
       *
       * */

      document
        .querySelector("#btn-print-ticket")
        .addEventListener("click", function (event) {
          imprimirTiquete();
        });

      document.body.addEventListener("keydown", function (event) {
        if (event.key === "p" || event.key === "P") {
          if (!document.querySelector("#venta").classList.contains("d-none")) {
            event.preventDefault();
            document.body.focus();
            imprimirTiquete();
          }
        }
      });

      /***
       * Limpiar tablero
       * */
      document
        .querySelector("#btn-clear-board")
        .addEventListener("click", function (event) {
          limpiarTablero();
        });

      /***
       * Terminar sesion
       * */
      document
        .querySelector("#btn-exit-app")
        .addEventListener("click", function (event) {
          localStorage.clear();
          window.location = "/";
        });

      /***
       * Terminar venta
       * */
      document
        .querySelector("#btn-stop-game")
        .addEventListener("click", function (event) {
          document.querySelector("#text-message-lock").innerHTML  = "";
          document.querySelector("#inPingLock").value = "";
          $("#modalLock").modal("show");
        });
      document
        .querySelector("#btn-lock-game")
        .addEventListener("click", function (event) {
          event.preventDefault();

          let ping = document.querySelector("#inPingLock").value;
          /*Ping para acceder a configuracion*/
          if (ping == "<%= enviroment.LOCK_PASSWORD %>") {
            document.querySelector("#inPingLock").value = "";
            $("#modalLock").modal("hide");

            var objetoSorteo = {
              sorteoId: localStorage.getItem("choose-game"),
            };
            fetch(api + "sorteo", {
              method: "LOCK",
              body: JSON.stringify(objetoSorteo),
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
              },
            })
              .then((response) => response.json())
              .then((response) => {
                if (response.exitoso) {
                  document.querySelector("#text-message-lock").innerHTML  =
                    "Venta detenida.";
                }
              });
          } else {
            document.querySelector("#inPingLock").value = "";
            document.querySelector("#text-message-lock").innerHTML  =
              "Datos incorrectos.";
          }
        });

      /***
       * Configuracion
       * */
      document
        .querySelector("#btn-access-config")
        .addEventListener("click", function (event) {
          event.preventDefault();
          let ping = document.querySelector("#inPing").value;
          /*Ping para acceder a configuracion*/
          if (ping == "<%= enviroment.CONFIG_PASSWORD %>") {
            $("#modalPing").modal("hide");
            showConfiguracion();
            document.querySelector("#inPing").value = "";
          } else {
            $("#modalPing").modal("hide");
            document.querySelector("#inPing").value = "";
          }
        });

      /***
       * Cambiar Ticket
       * */
      document
        .querySelector("#btn-reedem-game")
        .addEventListener("click", function (event) {
          event.preventDefault();
          let ticket = document.querySelector("#inTicket").value;
          window.location = "/cambiar?id=" + ticket;
        });

      document
        .querySelector("#btn-throw-cambiar")
        .addEventListener("click", function (event) {
          $("#modalCambiar").modal("show");
          document.querySelector("#inTicket").focus();
        });

      document
        .querySelector("#btn-throw-ping")
        .addEventListener("click", function (event) {
          if (localStorage.getItem("sesion-perfil") != "ADMIN") {
            $("#modalPing").modal("show");
            document.querySelector("#inTicket").focus();
          } else {
            showConfiguracion();
          }
        });

      /***
       * Balance Sorteos
       * */
      document
        .querySelector("#btn-balance-game")
        .addEventListener("click", function (event) {
          event.preventDefault();
          window.location = "/balance";
        });
    </script>
  </body>
</html>
