      function cargarUsuarios() {
        fetch(api + "usuarios", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              
              //Pintando
              let select = document.querySelector("#select-choose-seller");
              while (select.length > 0) {
                select.remove(select.length - 1);
              }
              data.resultado.forEach((element) => {
                let option = document.createElement("option");
                option.text = element.nombre;
                option.value = element.id;
                option.setAttribute("name", element.id);
                select.add(option);
              });

            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando usuarios, contacte el administrador.";
            }
            return;
          })
          .then((input)=>{
            // Seleccionando por defecto la sesion actual
            const selectElement = document.getElementById("select-choose-seller");
              selectElement.value = localStorage.getItem("sesion-id");
              bag.seller = selectElement.options[selectElement.selectedIndex].text;
              bag.render()
          });
      }

