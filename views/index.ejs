    </div>
    <div
      class="alert alert-danger d-none offset-4 col-4 mt-5 p-5"
      role="alert"
      id="alertSession"
    >
      <h4 class="alert-heading">Su sesión caduco!</h4>
      <p>Oh si! debes ingresar nuevamente</p>
      <hr />
      <p class="mb-0" id="txtTimer">Seras redireccionado en 2 segundos . . .</p>
    </div>
    <div
      class="d-flex justify-content-center"
      style="margin-top: 20%"
      id="loading"
    >
      <div
        class="spinner-grow"
        role="status"
        style="
          width: 10rem;
          height: 10rem;
          background-color: #dee2e6 !important;
        "
        id="spinnerLog"
      >
        <span class="sr-only">Loading...</span>
      </div>
    </div>

    <script src="/javascripts/qrcode.min.js"></script>
    <script src="/javascripts/modules/output.js"></script>
    <script src="/javascripts/renderer.js"></script>
    <script src="/javascripts/jquery-3.2.1.slim.min.js"></script>
    <script src="/javascripts/popper.min.js"></script>
    <script src="/javascripts/bootstrap.min.js"></script>
    <script>
      var api = "<%= enviroment.URL_API %>";
      var qrURL = "<%= enviroment.URL_QR %>";

      /*Verificar si tiene sesión*/
      if (localStorage.getItem("tokenSSO")) {
        /*Verificando token*/
        fetch(api + "usuarios/decode", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.exitoso) {
              /**
               * Basado en el perfil mostrar o dejar de mostrar
               */
              localStorage.setItem("sesion-accesos", data.resultado.accesos);
              localStorage.setItem("sesion-perfil", data.resultado.perfil);
              localStorage.setItem("sesion-usuario", data.resultado.usuario);
              localStorage.setItem("sesion-id", data.resultado.id);

              if (data.resultado.perfil != "ADMIN") {
                document
                  .querySelector("#contenedorSorteos")
                  .classList.add("d-none");
                document
                  .querySelector("#contenedorOpciones")
                  .classList.add("d-none");
                document.querySelector("#btn-close-game").classList.add("d-none");
                /*document
                  .querySelector("#contenedorAccionesAdministrador")
                  .classList.add("d-none");*/
              }
              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#venta").classList.remove("d-none");
            } else {
              /**
               * Caduco la sesión mensaje y redireccionar
               */

              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#venta").classList.add("d-none");
              document
                .querySelector("#alertSession")
                .classList.remove("d-none");

              localStorage.removeItem("tokenSSO");
              setTimeout(function () {
                window.location = "/";
              }, 2000);
            }
          });
      } else {
        document.querySelector("#venta").classList.add("d-none");
        document.querySelector("#loading").classList.remove("d-flex");
        document.querySelector("#loading").classList.add("d-none");
        document.querySelector("#alertSession").classList.remove("d-none");
        localStorage.removeItem("tokenSSO");
        setTimeout(function () {
          window.location = "/";
        }, 2000);
      }

      /**
       * Carga automatica
       */
      // Remueve el Flag de edicion al recaragar
       localStorage.removeItem("edit-ticket-number")
      /**
       * Datos de sorteos
       */
      cargarSorteos();

      function cargarSorteos() {
        fetch(api + "sorteo", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              document
                .querySelector("#form-set-config")
                .classList.remove("d-none");
              let select = document.querySelector("#select-choose-game");
              while (select.length > 0) {
                select.remove(select.length - 1);
              }
              data.resultado.forEach((element) => {
                let option = document.createElement("option");
                option.text = element.nombre;
                option.value = element.id;
                option.setAttribute("name", element.id);
                select.add(option);
              });
            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando sorteos, contacte el administrador.";
              document
                .querySelector("#form-set-config")
                .classList.add("d-none");
            }
            return;
          })
          .then((sorteo) => {
            if (localStorage.getItem("choose-game")) {
              document
                .querySelector("#select-choose-game")
                .setAttribute("disabled", true);
              document.querySelector("#select-choose-game").value =
                localStorage.getItem("choose-game");
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
            }
            return;
          })
          .then((titulo) => {
            if (localStorage.getItem("title-ticket")) {
              document.querySelector("#inputName-title-ticket").value =
                localStorage.getItem("title-ticket");
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
              document
                .querySelector("#inputName-title-ticket")
                .setAttribute("disabled", true);
            } else if (localStorage.getItem("choose-game")) {
              let autoTitle =
                document.querySelectorAll("#select-choose-game option")[
                  document.querySelector("#select-choose-game").selectedIndex
                ].text +
                "-" +
                localStorage.getItem("sesion-usuario");
              document.querySelector("#inputName-title-ticket").value =
                autoTitle;
              localStorage.setItem("title-ticket", autoTitle);
              document
                .querySelector("#inputName-title-ticket")
                .setAttribute("disabled", true);
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
            } else {
              document.querySelector("#inputName-title-ticket").value =
                "Sin titulo";
              document
                .querySelector("#inputName-title-ticket")
                .removeAttribute("disabled");
            }
            return;
          })
          .then((estado) => {
            cargarEstadoSorteo();
          });
      }

      /*Habilitando boton*/
      if (
        !localStorage.getItem("choose-game") &&
        !localStorage.getItem("title-ticket")
      ) {
        document.querySelector("#text-set-config").innerHTML = "Aceptar";
      }

      /**
       * Cargando estado de sorteo
       */
      function cargarEstadoSorteo() {
        let builder = document.querySelector("#estado");
        builder.innerHTML = '<table class="table table-bordered" id="numberTable"></table>';

        let builderSacado = document.querySelector("#estadoSacado");
        builderSacado.innerHTML = '<table class="table table-bordered" id="sacadoTable"></table>';

        let contenedorBillete = document.querySelector("div[id=estadoBillete]");
        contenedorBillete.innerHTML = "";

        document.querySelector("#chanceCantidad").innerHTML = 0;
        document.querySelector("#chancePlata").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);

        document.querySelector("#billeteCantidad").innerHTML = 0;
        document.querySelector("#billetePlata").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);

        let numeroSorteo = document.querySelectorAll(
          "#select-choose-game option"
        )[document.querySelector("#select-choose-game").selectedIndex].value;

        fetch(api + "sorteo/" + numeroSorteo + "/chances?ord=numero", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
          const table = document.getElementById("numberTable");
          const columns = 4;
          //Header
          const trheader = document.createElement("tr");
          const th = document.createElement("th");
          th.textContent = document.querySelectorAll("#select-choose-game option")[
            document.querySelector("#select-choose-game").selectedIndex
          ].text;
          th.setAttribute('colspan','8')
          trheader.appendChild(th)
          table.appendChild(trheader); 

          for (let row = 0; row < 25; row++) { // Crear 10 filas
              const tr = document.createElement("tr");
              for (let col = 0; col < columns; col++) { // Crear columnas para cada fila
                  const td = document.createElement("td");
                  var cantidadIterable = 0;
                  const number = (col * 25 + row).toString().padStart(2, '0'); // Formatear número como "00", "01", etc.
                  td.textContent = number;
                  td.classList.add("font-weight-bold")
                  tr.appendChild(td);
                  let numeroTemporal = data.resultado.find(
                    (elemento) => elemento.numero == number.toString().padStart(2, 0)
                  );
                  let cantidadSacada = 0
                  if (numeroTemporal) {
                    cantidadSacada = numeroTemporal.cantidad;
                    //cantidadIterable = (cantidadSacada > 0) ? cantidadSacada : 0
                    //numeroTemporal.cantidad = cantidadIterable
                  }
                  const tdCant = document.createElement("td");
                  tdCant.textContent = cantidadSacada
                  tr.appendChild(tdCant);
              }
              table.appendChild(tr); // Añadir la fila a la tabla
          }
            return data;
          })
          .then((data) => {
          const table = document.getElementById("sacadoTable");
          const columns = 4;
          //Header
          const trheader = document.createElement("tr");
          const th = document.createElement("th");
          th.textContent = "Final " + document.querySelectorAll("#select-choose-game option")[
            document.querySelector("#select-choose-game").selectedIndex
          ].text;
          th.setAttribute('colspan','8')
          trheader.appendChild(th)
          table.appendChild(trheader); 

          for (let row = 0; row < 25; row++) { // Crear 10 filas
              const tr = document.createElement("tr");
              for (let col = 0; col < columns; col++) { // Crear columnas para cada fila
                  const td = document.createElement("td");
                  var cantidadIterable = 0;
                  const number = (col * 25 + row).toString().padStart(2, '0'); // Formatear número como "00", "01", etc.
                  td.textContent = number;
                  td.classList.add("font-weight-bold")
                  tr.appendChild(td);
                  let numeroTemporal = data.resultado.find(
                    (elemento) => elemento.numero == number.toString().padStart(2, 0)
                  );
                  if (numeroTemporal) {
                    let cantidadSacada = numeroTemporal.cantidad - bag.sacado;
                    cantidadIterable = cantidadSacada //(cantidadSacada > 0) ? cantidadSacada : 0
                    numeroTemporal.cantidad = cantidadSacada
                  }
                  const tdCant = document.createElement("td");
                  tdCant.textContent = cantidadIterable
                  tr.appendChild(tdCant);
              }
              table.appendChild(tr); // Añadir la fila a la tabla
          }
            return data.resultado;
          })
          .then((totales) => {
            let cantidadTotal = 0;
            let montoTotal = 0;
            totales.forEach((elemento) => {
              cantidadTotal = cantidadTotal + Number(elemento.cantidad);

              montoTotal = montoTotal + Number(elemento.cantidad)*0.25;
            });
            document.querySelector("#chanceCantidad").innerHTML =
              cantidadTotal || 0;
            document.querySelector("#chancePlata").innerHTML = (
              Math.round(montoTotal * 100) / 100
            ).toFixed(2);
             return Math.round(montoTotal * 100) / 100
          })
          .then((something => {
            /* Ganadores Chance*/
            fetch(api + "ganadores/" + numeroSorteo + "?accion=chance", {
              method: "GET",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
              },
            })
              .then((response) => response.json())
              .then((totales) => {
                let cantidadTotal = 0;
                let montoTotal = 0;
                totales.resultado.forEach((elemento) => {
                  montoTotal = montoTotal + elemento.valorganador1er + elemento.valorganador2do
                    + elemento.valorganador3ro;
                });
                document.querySelector("#chancePremioTotal").innerHTML = (
                  Math.round(montoTotal * 100) / 100
                ).toFixed(2);
                let balance = something - montoTotal
                if (balance < 0) {
                  document.querySelector("#chanceBalanceTotal").classList.add("text-danger");
                } else {
                  document.querySelector("#chanceBalanceTotal").classList.remove("text-danger");
                }
                if (montoTotal == 0) {
                  balance = "----.--";
                }
                document.querySelector("#chanceBalanceTotal").innerHTML =
                  balance || 0;
              });
          }));

        /*Billetes*/
        fetch(api + "sorteo/" + numeroSorteo + "/billetes", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            contenedorBillete = document.querySelector("div[id=estadoBillete]");
            contenedorBillete.innerHTML = '<table class="table table-bordered" id="billeteTable"></table>';
            const table = document.getElementById("billeteTable");
            const columns = 4;

            //Header
            const trheader = document.createElement("tr");
            const th = document.createElement("th");
            th.textContent = "Billetes"
            th.setAttribute('colspan','8')
            trheader.appendChild(th)
            table.appendChild(trheader); 

            const columnQty = data.resultado.length / 4 ;
            
            var number = 0
            for (let row = 0; row < columnQty; row++) {
              if (number >= data.resultado.length)
                continue;
              const tr = document.createElement("tr");
              for (let col = 0; col < columns; col++) { // Crear columnas para cada fila
                  if (number >= data.resultado.length)
                    continue;
                  const td = document.createElement("td");
                  var cantidadIterable = 0;
                  //const number = (col * columnQty + row).toString().padStart(2, '0'); // Formatear número como "00", "01", etc.
                  td.textContent = data.resultado[number].numero;
                  td.classList.add("font-weight-bold")
                  tr.appendChild(td);

                  const tdCant = document.createElement("td");
                  tdCant.textContent = data.resultado[number].cantidad
                  tr.appendChild(tdCant);
                  number = number + 1
              }
              table.appendChild(tr); // Añadir la fila a la tabla
          }

            return data.resultado;
          })
          .then((totales) => {
            let cantidadTotal = 0;
            let montoTotal = 0;
            totales.forEach((elemento) => {
              cantidadTotal = cantidadTotal + Number(elemento.cantidad);
              montoTotal = montoTotal + elemento.dineroVenta;
            });
            document.querySelector("#billeteCantidad").innerHTML =
              cantidadTotal || 0;
            document.querySelector("#billetePlata").innerHTML = (
              Math.round(montoTotal * 100) / 100
            ).toFixed(2);
            return Math.round(montoTotal * 100) / 100
          })
          .then((something => {
            /* Ganadores Billetes */
            fetch(api + "ganadores/" + numeroSorteo + "?accion=billete", {
              method: "GET",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
              },
            })
              .then((response) => response.json())
              .then((totales) => {
                let cantidadTotal = 0;
                let montoTotal = 0;
                totales.resultado.forEach((elemento) => {
                  cantidadTotal = cantidadTotal + Number(elemento.cantidad);
                  montoTotal = montoTotal + elemento.valorganador1er + elemento.valorganador2do
                    + elemento.valorganador3ro;
                });

                document.querySelector("#BilletePremioTotal").innerHTML = (
                  Math.round(montoTotal * 100) / 100
                ).toFixed(2);
                let balance = something - montoTotal
                if (balance < 0) {
                  document.querySelector("#BilleteBalanceTotal").classList.add("text-danger");
                } else {
                  document.querySelector("#BilleteBalanceTotal").classList.remove("text-danger");
                }
                if (montoTotal == 0) {
                  balance = "----.--";
                }
                document.querySelector("#BilleteBalanceTotal").innerHTML =
                  balance || 0;
              });
          }));

      }

       /**
       *
       *  Cargar Vendedores
       *
       * * */

      cargarUsuarios();
      function cargarUsuarios() {
        fetch(api + "usuarios", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              
              //Pintando
              let select = document.querySelector("#select-choose-seller");
              while (select.length > 0) {
                select.remove(select.length - 1);
              }
              data.resultado.forEach((element) => {
                let option = document.createElement("option");
                option.text = element.nombre;
                option.value = element.id;
                option.setAttribute("name", element.id);
                select.add(option);
              });

            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando usuarios, contacte el administrador.";
            }
            return;
          })
          .then((input)=>{
            // Seleccionando por defecto la sesion actual
            const selectElement = document.getElementById("select-choose-seller");
              selectElement.value = localStorage.getItem("sesion-id");
              bag.seller = selectElement.options[selectElement.selectedIndex].text;
              bag.render()
          });
      }

      /**
       *
       *  Crear sorteo
       *
       * * */
      document
        .querySelector("#form-create-game")
        .addEventListener("submit", function (event) {
          event.preventDefault();
          document
            .querySelector("#spinner-create-game")
            .classList.remove("d-none");
          document.querySelector("#text-create-game").classList.add("d-none");
          document.querySelector("#error-create-game").innerHTML = "";
          document.querySelector("#success-create-game").innerHTML = "";
          if (document.querySelector("#inputName-create-game").value === "") {
            document
              .querySelector("#spinner-create-game")
              .classList.add("d-none");
            document
              .querySelector("#text-create-game")
              .classList.remove("d-none");
            document.querySelector("#error-create-game").innerHTML =
              "Se requiere el nombre del sorteo, para proceder.";
            return false;
          }

          var data = {
            usuarioId: localStorage.getItem("sesion-id"),
            nombreSorteo: document.querySelector("#inputName-create-game")
              .value,
          };
          fetch(api + "sorteo", {
            method: "POST",
            body: JSON.stringify(data),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                document
                  .querySelector("#spinner-create-game")
                  .classList.add("d-none");
                document
                  .querySelector("#text-create-game")
                  .classList.remove("d-none");
                document.querySelector("#success-create-game").innerHTML =
                  data.resultado.mensaje;
              } else {
                document.querySelector("#inputName-create-game").value = "";
                document.querySelector("#error-create-game").innerHTML =
                  data.resultado;
              }
              document
                .querySelector("#spinner-create-game")
                .classList.add("d-none");
              document
                .querySelector("#text-create-game")
                .classList.remove("d-none");
            })
            .then((data) => {
              cargarSorteos();
              document.querySelector("#inputName-create-game").value = "";
            });
        });

      /***
       * Cerrar Sorteo
       *
       */

      function cerrarSorteo() {
        var data = {
          sorteoId: localStorage.getItem("choose-game"),
        };

        fetch(api + "sorteo", {
          method: "PATCH",
          body: JSON.stringify(data),
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {})
          .finally(() => {});
      }

      document
        .querySelector("#btn-close-game")
        .addEventListener("click", function (event) {
          event.preventDefault();
          document.querySelector("#text-close-game").classList.add("d-none");
          document
            .querySelector("#spinner-close-game")
            .classList.remove("d-none");

          cerrarSorteo();

          document.querySelector("#text-close-game").classList.remove("d-none");
          document.querySelector("#spinner-close-game").classList.add("d-none");

          cargarSorteos();

          document
            .querySelector("#inputName-title-ticket")
            .removeAttribute("disabled");
          document
            .querySelector("#select-choose-game")
            .removeAttribute("disabled");

          let builder = document.querySelector("#estado");
          builder.innerHTML = "";

          document.querySelector("#chanceCantidad").innerHTML = 0;
          document.querySelector("#chancePlata").innerHTML = (
            Math.round(0 * 100) / 100
          ).toFixed(2);

          document.querySelector("#billeteCantidad").innerHTML = 0;
          document.querySelector("#billetePlata").innerHTML = (
            Math.round(0 * 100) / 100
          ).toFixed(2);
        });

      /**
       *
       * Actualiza el sorteo en venta
       *
       */
      document
        .querySelector("#btn-refresh-game")
        .addEventListener("click", function (event) {
          event.preventDefault();

          document.querySelector("#text-refresh-game").classList.add("d-none");
          document
            .querySelector("#spinner-refresh-game")
            .classList.remove("d-none");

          cargarEstadoSorteo();

          document
            .querySelector("#text-refresh-game")
            .classList.remove("d-none");
          document
            .querySelector("#spinner-refresh-game")
            .classList.add("d-none");
        });
      /**
       *
       * Cambiar configuracion
       *    Titulo del tiquete
       *    Sorteo en venta
       * * */

      document
        .querySelector("#form-set-config")
        .addEventListener("submit", function (event) {
          event.preventDefault();

          /**
           * Habilitar modificacion
           */
          let isTitle = document
            .querySelector("#inputName-title-ticket")
            .hasAttribute("disabled");
          let isGame = document
            .querySelector("#select-choose-game")
            .hasAttribute("disabled");
          if (isTitle || isGame) {
            document
              .querySelector("#inputName-title-ticket")
              .removeAttribute("disabled");
            document
              .querySelector("#select-choose-game")
              .removeAttribute("disabled");
            document.querySelector("#text-set-config").innerHTML = "Aceptar";
          } else {
            localStorage.setItem(
              "title-ticket",
              document.querySelector("#inputName-title-ticket").value
            );
            localStorage.setItem(
              "choose-game",
              document
                .querySelectorAll("#select-choose-game option")
                [
                  document.querySelector("#select-choose-game").selectedIndex
                ].getAttribute("name")
            );
            document
              .querySelector("#inputName-title-ticket")
              .setAttribute("disabled", true);
            document
              .querySelector("#select-choose-game")
              .setAttribute("disabled", true);
            document.querySelector("#text-set-config").innerHTML = "Modificar";

            bag.id();
            globalChance.person = localStorage.getItem("title-ticket");
            bag.render();
          }
        });

      /* *
       *
       * Utilidades de tablero
       *
       * */
      function limpiarTablero() {
        bag.clear();
        bag.calc();
        bag.render();
        globalChance.receiptCount = 0;
        document.querySelector("#search").value = "";
        document.querySelector("#iBillete").value = "";
        document.querySelector("#iBilleteQty").value = "";
        document.querySelectorAll("#chanceBuilder input").forEach((element) => {
          element.value = "";
        });
      }
      function imprimirTiquete(event) {
        document.querySelector("#text-print-ticket").classList.add("d-none");
        document
          .querySelector("#spinner-print-ticket")
          .classList.remove("d-none");
        document.querySelector("#text-error-ticket").innerHTML = "";

        if (!localStorage.getItem("choose-game")) {
          /**
           * 
           * Removiendo transicion
           * */
           document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
          /*
          * Agregar Modal
          * Mensaje no exitoso
          */
          document.querySelector("#text-error-ticket").innerHTML =
          "Debes seleccionar un sorteo activo para poder vender";

        $("#modalErrorTicket").modal("show");

          return;
        }


        // Edicion Activa
        if (localStorage.getItem("edit-ticket-number")) {
          /**
           * 
           * Removiendo transicion
           * */
           document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
          /*
          * Agregar Modal
          * Mensaje no exitoso
          */
          document.querySelector("#text-error-ticket").innerHTML =
          "Debes completar la edicion solicitada antes de poder vender";

        $("#modalErrorTicket").modal("show");

          return;
        }

        if (!localStorage.getItem("title-ticket")) {
          /**
           * 
           * Removiendo transicion
           * */
           document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
          /*
          * Agregar Modal
          * Mensaje no exitoso
          */
          document.querySelector("#text-error-ticket").innerHTML =
          "Debes seleccionar un titulo para los ticketes";

        $("#modalErrorTicket").modal("show");
          return;
        }

        if (bag.items.length > 0) {
          var arregloRegistros = [];

          bag.items.forEach((element) => {
            var objetoRegistro = {
              tipo: null,
              numero: null,
              cantidad: null,
              valor: null,
              precio: null,
            };

            if (element.number.length == 2) objetoRegistro.tipo = "CHANCE";
            else objetoRegistro.tipo = "BILLETE";

            objetoRegistro.numero = element.number;
            objetoRegistro.cantidad = element.qty;
            objetoRegistro.valor = element.total;
            objetoRegistro.precio = element.price;

            arregloRegistros.push(objetoRegistro);
          });

          var objetoSorteo = {
            sorteoId: localStorage.getItem("choose-game"),
            userId:localStorage.getItem("sesion-id"),
            valor: bag.total,
            registros: arregloRegistros,
          };

          fetch(api + "tiquete/mq", {
            method: "POST",
            body: JSON.stringify(objetoSorteo),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                globalChance.receiptCount = data.resultado.id;
                bag.render();
                document.querySelector("#outPut1").innerHTML =
                  document.querySelector("#ticketOutput").innerHTML;
                generarQR(
                  qrURL + "cambiar?id=" + globalChance.receiptCount.toString()
                );
                window.print();
                limpiarTablero();
              } else {
                /*Agregar Modal
                 * Mensaje no exitoso
                 */
                document.querySelector("#text-error-ticket").innerHTML =
                  data.resultado;

                $("#modalErrorTicket").modal("show");
              }

              document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
            });
        }
      }

      /* *
       *
       * Tablero de venta
       *
       * */

      document
        .querySelector("#btn-print-ticket")
        .addEventListener("click", function (event) {
          imprimirTiquete();
        });

      document.body.addEventListener("keydown", function (event) {
        if (event.key === "p" || event.key === "P") {
          if (!document.querySelector("#venta").classList.contains("d-none")) {
            event.preventDefault();
            document.body.focus();
            imprimirTiquete();
          }
        }
      });

      /***
       * Limpiar tablero
       * */
      document
        .querySelector("#btn-clear-board")
        .addEventListener("click", function (event) {
          limpiarTablero();
        });

      /***
       * Terminar sesion
       * */
      document
        .querySelector("#btn-exit-app")
        .addEventListener("click", function (event) {
          localStorage.clear();
          window.location = "/";
        });

      /***
       * Terminar venta
       * */
      document
        .querySelector("#btn-stop-game")
        .addEventListener("click", function (event) {
          document.querySelector("#text-message-lock").innerHTML  = "";
          document.querySelector("#inPingLock").value = "";
          $("#modalLock").modal("show");
        });
      document
        .querySelector("#btn-lock-game")
        .addEventListener("click", function (event) {
          event.preventDefault();

          let ping = document.querySelector("#inPingLock").value;
          /*Ping para acceder a configuracion*/
          if (ping == "<%= enviroment.LOCK_PASSWORD %>") {
            document.querySelector("#inPingLock").value = "";
            $("#modalLock").modal("hide");

            var objetoSorteo = {
              sorteoId: localStorage.getItem("choose-game"),
            };
            fetch(api + "sorteo", {
              method: "LOCK",
              body: JSON.stringify(objetoSorteo),
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
              },
            })
              .then((response) => response.json())
              .then((response) => {
                if (response.exitoso) {
                  document.querySelector("#text-message-lock").innerHTML  =
                    "Venta detenida.";
                }
              });
          } else {
            document.querySelector("#inPingLock").value = "";
            document.querySelector("#text-message-lock").innerHTML  =
              "Datos incorrectos.";
          }
        });

      /***
       * Configuracion
       * */
      document
        .querySelector("#btn-access-config")
        .addEventListener("click", function (event) {
          event.preventDefault();
          let ping = document.querySelector("#inPing").value;
          /*Ping para acceder a configuracion*/
          if (ping == "<%= enviroment.CONFIG_PASSWORD %>") {
            $("#modalPing").modal("hide");
            showConfiguracion();
            document.querySelector("#inPing").value = "";
          } else {
            $("#modalPing").modal("hide");
            document.querySelector("#inPing").value = "";
          }
        });

      /***
       * Cambiar Ticket
       * */
      document
        .querySelector("#btn-reedem-game")
        .addEventListener("click", function (event) {
          event.preventDefault();
          let ticket = document.querySelector("#inTicket").value;
          window.location = "/cambiar?id=" + ticket;
        });

      document
        .querySelector("#btn-throw-cambiar")
        .addEventListener("click", function (event) {
          $("#modalCambiar").modal("show");
          setTimeout(function() {
            document.querySelector("#inTicket").focus();
            }, 500);
        });

      document
        .querySelector("#btn-throw-ping")
        .addEventListener("click", function (event) {
          event.preventDefault();
          if (localStorage.getItem("sesion-perfil") != "ADMIN") {
            $("#modalPing").modal("show");
            setTimeout(function() {
                document.querySelector("#form-ping .modal-body #inPing").focus();
            }, 500);
          } else {
            showConfiguracion();
          }
        });

      /***
       * Balance Sorteos
       * */
      document
        .querySelector("#btn-balance-game")
        .addEventListener("click", function (event) {
          event.preventDefault();
          window.location = "/balance";
        });

       /***
       * Change the seller on select
       * */
      const selectElement = document.getElementById("select-choose-seller");
      selectElement.addEventListener("change", function() {
        // Obtiene el valor seleccionado
        //const selectedValue = selectElement.value;
        localStorage.setItem("sesion-id",selectElement.value);
        bag.seller = selectElement.options[selectElement.selectedIndex].text;
        bag.render()
      });

      /***
       * Change the customer name
       * */
       const inputCustomerName = document.getElementById("optional-customer-name");
       const displayCustomerName = document.getElementById("display-customer-name");
       inputCustomerName.addEventListener("input", function() {
          bag.customerName = inputCustomerName.value;
          console.log(inputCustomerName.value)
          bag.render()
      });

      /***
       * Sacado
       * */
       const inputSacado = document.getElementById("optional-sacado");
       inputSacado.addEventListener("input", function() {
          bag.sacado = Number(inputSacado.value);
      });
      
      /***
       * Editar Ticket
       * */
      document.querySelector("#noOldTicket")
      .addEventListener("keydown", function ({key}) {
        if (key==="Enter") {
          document.querySelector("#btnEditar").click()
        }
      })

      document.querySelector("#btnEditar")
      .addEventListener("click",function() {
        localStorage.removeItem("edit-ticket-number")
        //Traer el ticket de la BD
        if (isNaN(document.querySelector("#noOldTicket").value) || document.querySelector("#noOldTicket").value == ""){
          //Mensaje
          return
        }    
        fetch(api + "tiquete/"+document.querySelector("#noOldTicket").value, {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
          .then((response) => response.json())
          .then((data) => {
            if (data.resultado.length < 1) {
              /**
               * 
               * Removiendo transicion
               * */
              document
              .querySelector("#spinner-print-ticket")
              .classList.add("d-none");
                document
                  .querySelector("#text-print-ticket")
                  .classList.remove("d-none");
              /*
              * Agregar Modal
              * Mensaje no exitoso
              */
              document.querySelector("#text-error-ticket").innerHTML =
              "Recuerda solo puedes recargar ticketes que hayas vendido.";

              $("#modalErrorTicket").modal("show");

              return;
            }
            //Montarlo en la bolsa
            for (let editarIndex = 0; editarIndex < data.resultado.length; editarIndex++) {
              const element = data.resultado[editarIndex];
              let newItem = {
                number:"",
                qty:0,
                price:0,
                total:0
              }
              newItem.number = element.numero
              newItem.qty = element.cantidad
              newItem.price = element.tipo == "BILLETE" ? 1.00 : 0.25
              newItem.total = element.valorcompra      
              let indexItem = bag.items.findIndex(object=>object.number === newItem.number)
              
              if (indexItem>-1) {
                if (newItem.qty==0) {
                  bag.update(indexItem,newItem)
                } else {
                  bag.push(indexItem,newItem)
                }
              } else {
                if (newItem.qty>0) {
                  bag.add(newItem) 
                }                    
              }
            }

            // Cambiar numero
            globalChance.receiptCount = data.resultado[0].GameTicketId
            localStorage.setItem("edit-ticket-number",data.resultado[0].GameTicketId)
            bag.render()
            document.querySelector("#btnEditar").classList.add("d-none")
            document.querySelector("#btnAceptarEditar").classList.remove("d-none")
            return data
          })
          .then((data) => {
            
          })
      })
      
      //Editar en la BD el ticket
      document.querySelector("#btnAceptarEditar")
      .addEventListener("click",function () {

        if (bag.items.length > 0) {
          var arregloRegistros = [];

          bag.items.forEach((element) => {
            var objetoRegistro = {
              tipo: null,
              numero: null,
              cantidad: null,
              valor: null,
              precio: null,
            };

            if (element.number.length == 2) objetoRegistro.tipo = "CHANCE";
            else objetoRegistro.tipo = "BILLETE";

            objetoRegistro.numero = element.number;
            objetoRegistro.cantidad = element.qty;
            objetoRegistro.valor = element.total;
            objetoRegistro.precio = element.price;

            arregloRegistros.push(objetoRegistro);
          });

          var objetoSorteo = {
            sorteoId: localStorage.getItem("choose-game"),
            userId:localStorage.getItem("sesion-id"),
            valor: bag.total,
            registros: arregloRegistros,
            editar: localStorage.getItem("edit-ticket-number")
          };


          fetch(api + "tiquete/mq", {
            method: "POST",
            body: JSON.stringify(objetoSorteo),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                globalChance.receiptCount = data.resultado.id;
                bag.render();
                document.querySelector("#outPut1").innerHTML =
                  document.querySelector("#ticketOutput").innerHTML;
                generarQR(
                  qrURL + "cambiar?id=" + globalChance.receiptCount.toString()
                );
                window.print();
                limpiarTablero();
              } else {
                /*Agregar Modal
                 * Mensaje no exitoso
                 */
                document.querySelector("#text-error-ticket").innerHTML =
                  data.resultado;

                $("#modalErrorTicket").modal("show");
              }

              document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
            })
            .then((response) => {
              document.querySelector("#btnEditar").classList.remove("d-none")
              document.querySelector("#btnAceptarEditar").classList.add("d-none")
              globalChance.receiptCount = 0
              localStorage.removeItem("edit-ticket-number")
              bag.render()
              
              document.querySelector("#noOldTicket").value = ""
            });
        }
        
      })

    </script>
  </body>
</html>
