        <div class="d-flex" id="estadoBillete"></div>
      </div>
      <div class="col-3">
        <div class="d-flex card-border" id="estadoSorteo">
          <div class="col-12 font-weight-bold my-2" id="totalSorteo">
            <div class="d-flex">
              <div class="col-12 card-border">Ventas</div>
            </div>
            <div class="d-flex">
              <div class="offset-4 col-4">Cantidad</div>
              <div class="col-4">Monto</div>
            </div>
