            arregloRegistros.push(objetoRegistro);
          });

          var objetoSorteo = {
            sorteoId: localStorage.getItem("choose-game"),
            userId:localStorage.getItem("sesion-id"),
            valor: bag.total,
            registros: arregloRegistros,
            editar: localStorage.getItem("edit-ticket-number")
          };


          fetch(api + "tiquete/mq", {
            method: "POST",
            body: JSON.stringify(objetoSorteo),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                globalChance.receiptCount = data.resultado.id;
                bag.render();
                document.querySelector("#outPut1").innerHTML =
                  document.querySelector("#ticketOutput").innerHTML;
                
                  
                  //Necesito consumir el endpoint de cifrar el id del tiquete
                fetch(api + "tiquete/cifrar?id="+objetoSorteo.editar.toString(), {
                  method: "GET",
                  headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
                  },
                })
                .then((response) => response.json())
                .then(async (data) => {

                  function getPanamaDateTime() {
                    // Crear fecha con timezone de Panamá
                    const panamaDate = new Date().toLocaleString("en-US", {timeZone: "America/Panama"});
                    const date = new Date(panamaDate);
                    
                    // Formatear fecha en DDHH24MISS
                    const day = date.getDate().toString().padStart(2,'0');
                    const hours = date.getHours().toString().padStart(2,'0');
                    const minutes = date.getMinutes().toString().padStart(2,'0'); 
                    const seconds = date.getSeconds().toString().padStart(2,'0');

                    return `${day}${hours}${minutes}${seconds}`;
                  }

                  if (data.exitoso) {
                    //con el token generado debo generar el QR
                    generarQR(api+ "cambiar?id="+data.token.toString());

                    // Capturar el elemento del ticket
                    const ticketElement = document.querySelector("#ticketOutput");
                    
                    // Convertir a imagen usando html2canvas
                    const canvas = await html2canvas(ticketElement, {
                      backgroundColor: '#ffffff',
                      scale: 2 // Mejor calidad
                    });
                    
                    // Convertir el canvas a una URL de datos (base64)
                    const imageData = canvas.toDataURL('image/jpeg', 0.8);
                    
                    // Descargar la imagen temporalmente
                    const link = document.createElement('a');
                    const timestamp = getPanamaDateTime();
                    link.download = 'ticket-'+bag.seller+'-'+objetoSorteo.editar.toString()+'-'+timestamp+'.jpg';
                    link.href = imageData;
                    link.click();

                    window.print();
                    limpiarTablero();
                  } else {
                    /*Agregar Modal
                     * Mensaje no exitoso
                     */
                    document.querySelector("#text-error-ticket").innerHTML =
                      data.resultado;

                    $("#modalErrorTicket").modal("show");
                    window.print();
                    limpiarTablero();
                  }
                });


              } else {
                /*Agregar Modal
                 * Mensaje no exitoso
                 */
                document.querySelector("#text-error-ticket").innerHTML =
                  data.resultado;

                $("#modalErrorTicket").modal("show");
              }

              document
                .querySelector("#spinner-print-ticket")
                .classList.add("d-none");
              document
                .querySelector("#text-print-ticket")
                .classList.remove("d-none");
            })
            .then((response) => {
              document.querySelector("#btnEditar").classList.remove("d-none")
              document.querySelector("#btnAceptarEditar").classList.add("d-none")
              document.querySelector("#btnEliminarEditar").classList.add("d-none")    
              //UX Mobile - Editar
              document.querySelector("#mobile-btn-kit-1").classList.remove("d-none")
              document.querySelector("#mobile-btn-kit-2").classList.add("d-none")
              document.querySelector("[name='mobile-edit-ticket']").classList.remove("d-none")
              document.querySelector("[name='optional-customer-name-mobile']").classList.remove("d-none")

              globalChance.receiptCount = 0
              localStorage.removeItem("edit-ticket-number")
              bag.render()
              
              //UX - Mobile
              document.querySelector('[name="mobile-input-ux"]').remove()
              document.querySelector("#noOldTicket").value = ""
            });
        }
        
      })

      async function compartirPorWhatsapp_v1() {
        // Mostrar spinner
        document.querySelector("#text-whatsapp-ticket").classList.add("d-none");
        document.querySelector("#spinner-whatsapp-ticket").classList.remove("d-none");
        
        try {
          // Capturar el contenido del ticket
          const ticketElement = document.querySelector("#ticketOutput");
          
          // Usar html2canvas para convertir el contenido a imagen
          const canvas = await html2canvas(ticketElement, {
            backgroundColor: '#ffffff',
            scale: 2
          });
          
          // Convertir canvas a imagen base64
          const imageData = canvas.toDataURL('image/jpeg', 0.8);
          
          // Crear enlace de WhatsApp con la imagen
          const message = "Mi ticket";
          const whatsappURL = `whatsapp://send?text=${encodeURIComponent(message)}&data-action=share/whatsapp/share`;
          
          // Abrir WhatsApp
          window.location.href = whatsappURL;
        } catch (error) {
          console.error('Error al compartir por WhatsApp:', error);
          alert('Hubo un error al intentar compartir por WhatsApp');
       } finally {
          // Ocultar spinner
          document.querySelector("#spinner-whatsapp-ticket").classList.add("d-none");
          document.querySelector("#text-whatsapp-ticket").classList.remove("d-none");
        }
      }

    </script>
    <script src="/javascripts/edit-ticket.js"></script>
  </body>
</html>
