    <script>
      var api = "<%= enviroment.URL_API %>";
      var qrURL = "<%= enviroment.URL_QR %>";

      /*Verificar si tiene sesión*/
      if (localStorage.getItem("tokenSSO")) {
        // Función para verificar y renovar el token
        function checkAndRenewToken() {
          const token = localStorage.getItem("tokenSSO");
          if (!token) return;

          // Decodificar el token para obtener la fecha de expiración
          const tokenData = JSON.parse(atob(token.split('.')[1]));
          const expirationTime = tokenData.exp * 1000; // Convertir a milisegundos
          const currentTime = Date.now();
          const timeRemaining = expirationTime - currentTime;
          const thirtyMinutesInMs = 30 * 60 * 1000;

          console.log("Tiempo restante para el token:", timeRemaining);
          console.log("Tiempo restante en minutos:", timeRemaining / (1000 * 60));
          console.log("Tiempo restante en horas:", timeRemaining / (1000 * 60 * 60));
          // Si quedan menos de 30 minutos, renovar el token
          if (timeRemaining < thirtyMinutesInMs) {
            fetch(api + "usuarios/renew", {
              method: "GET",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + token,
              },
            })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso && data.token) {
                localStorage.setItem("tokenSSO", data.token);
                console.log("Token renovado exitosamente");
              }
            })
            .catch(error => {
              console.error("Error al renovar el token:", error);
            });
          }
        }

        // Verificar el token cada 5 minutos
        setInterval(checkAndRenewToken, 5 * 60 * 1000);
        
        // Verificación inicial del token
        checkAndRenewToken();

        /*Verificando token*/
        fetch(api + "usuarios/decode", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.exitoso) {
              /**
               * Basado en el perfil mostrar o dejar de mostrar
               */
              localStorage.setItem("sesion-accesos", data.resultado.accesos);
              localStorage.setItem("sesion-perfil", data.resultado.perfil);
              localStorage.setItem("sesion-usuario", data.resultado.usuario);
              localStorage.setItem("sesion-id", data.resultado.id);
              localStorage.setItem("sesion-%chance", data.resultado.porcentajeChance);
              localStorage.setItem("sesion-%billete", data.resultado.porcentajeBillete);
              localStorage.setItem("sesion-hijos", data.resultado.hijos);

              //Pintar usuario
              document.getElementsByName("mobile-user-name")[0].innerHTML =
                data.resultado.usuario;
              
              document.getElementsByName("user-md-name")[0].innerHTML =
                data.resultado.usuario;

              if (data.resultado.perfil == "SUPERVISOR") {
                document
                  .querySelector("#contenedorSorteos")
                  .classList.add("d-none");

                document.querySelector("#btn-close-game").classList.add("d-none");
                document.querySelector("#btn-balance-game").classList.add("d-none");

                document.querySelector("#btn-stop-game").classList.add("d-none");
                document.querySelector("#btn-winner-game").classList.add("d-none");

                document
                  .querySelector("#btn-reactive-game")
                  .classList.add("d-none");

                
                /*document
                  .querySelector("#contenedorAccionesAdministrador")
                  .classList.add("d-none");*/
                  document.querySelector("#select-seller").classList.add("d-none")
                  document.querySelector("#row-optional-sacado").classList.add("d-none")
                  document.querySelector("#estadoSacado").classList.remove("d-flex")
                  document.querySelector("#estadoSacado").classList.add("d-none")
                  document.querySelector("#form-set-config button").classList.add("d-none")
              } else if (data.resultado.perfil != "ADMIN") {
                document
                  .querySelector("#contenedorSorteos")
                  .classList.add("d-none");
                document
                  .querySelector("#contenedorOpciones")
                  .classList.add("d-none");
                document.querySelector("#btn-close-game").classList.add("d-none");
                /*document
                  .querySelector("#contenedorAccionesAdministrador")
                  .classList.add("d-none");*/
                  document.querySelector("#select-seller").classList.add("d-none")
                  document.querySelector("#row-optional-sacado").classList.add("d-none")
                  document.querySelector("#estadoSacado").classList.remove("d-flex")
                  document.querySelector("#estadoSacado").classList.add("d-none")
                  document.querySelector("#form-set-config button").classList.add("d-none")
              } else {
                cargarUsuarios()
              }
              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#venta").classList.remove("d-none");
            } else {
              /**
               * Caduco la sesión mensaje y redireccionar
               */

              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#venta").classList.add("d-none");
              document
                .querySelector("#alertSession")
                .classList.remove("d-none");

              localStorage.removeItem("tokenSSO");
              setTimeout(function () {
                window.location = "/";
              }, 2000);
            }
          });
      } else {
        document.querySelector("#venta").classList.add("d-none");
        document.querySelector("#loading").classList.remove("d-flex");
        document.querySelector("#loading").classList.add("d-none");
        document.querySelector("#alertSession").classList.remove("d-none");
        localStorage.removeItem("tokenSSO");
        setTimeout(function () {
          window.location = "/";
        }, 2000);
      }

      /**
       * Carga automatica
       */
      // Remueve el Flag de edicion al recaragar
       localStorage.removeItem("edit-ticket-number")
      // Colocamos Titulo por defecto
      localStorage.setItem("title-ticket", "*Lucky's Seven*");
      globalChance.person = localStorage.getItem("title-ticket")
      /**
       * Datos de sorteos
       */
      
      cargarSorteos();

      function cargarSorteos() {
        fetch(api + "sorteo", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              
              document
                .querySelector("#form-set-config")
                .classList.remove("d-none");
              let select = document.querySelector("#select-choose-game");
              while (select.length > 0) {
                select.remove(select.length - 1);
              }
              data.resultado.forEach((element) => {
                let option = document.createElement("option");
                option.text = element.nombre;
                option.value = element.id;
                option.setAttribute("name", element.id);
                select.add(option);
              });

              //Setting Automatico del ultimo sorteo creado
              if(data.resultado.length>0)
                localStorage.setItem("choose-game",data.resultado[0].id);

            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando sorteos, contacte el administrador.";
              document
                .querySelector("#form-set-config")
                .classList.add("d-none");
            }
            return;
          })
          .then((sorteo) => {
            if (localStorage.getItem("choose-game")) {
              document
                .querySelector("#select-choose-game")
                .setAttribute("disabled", true);
              document.querySelector("#select-choose-game").value =
                localStorage.getItem("choose-game");
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
            }
            return;
          })
          .then((titulo) => {
            if (localStorage.getItem("title-ticket")) {
              document.querySelector("#inputName-title-ticket").value =
                localStorage.getItem("title-ticket");
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
              document
                .querySelector("#inputName-title-ticket")
                .setAttribute("disabled", true);
            } else if (localStorage.getItem("choose-game")) {
              let autoTitle =
                document.querySelectorAll("#select-choose-game option")[
                  document.querySelector("#select-choose-game").selectedIndex
                ].text +
                "-" +
                localStorage.getItem("sesion-usuario");
              document.querySelector("#inputName-title-ticket").value =
                autoTitle;
              localStorage.setItem("title-ticket", autoTitle);
              document
                .querySelector("#inputName-title-ticket")
                .setAttribute("disabled", true);
              document.querySelector("#text-set-config").innerHTML =
                "Modificar";
            } else {
              document.querySelector("#inputName-title-ticket").value =
                "Sin titulo";
              document
                .querySelector("#inputName-title-ticket")
                .removeAttribute("disabled");
            }
            return;
          })
          .then((estado) => {
            bag.render()
            cargarEstadoSorteo();
          });
      }

      /*Habilitando boton*/
      if (
        !localStorage.getItem("choose-game") &&
        !localStorage.getItem("title-ticket")
      ) {
        document.querySelector("#text-set-config").innerHTML = "Aceptar";
      }

      /**
       * Cargando estado de sorteo
       */
      function cargarEstadoSorteo() {
        //Nueva UX Mobile
        document.querySelector("#table-mobile-status").innerHTML = ""
        document.querySelector("#table-mobile-finantial").innerHTML = ""
        
        let builder = document.querySelector("#estado");
        builder.innerHTML = '<table class="table table-bordered" id="numberTable"></table>';

        let builderSacado = document.querySelector("#estadoSacado");
        builderSacado.innerHTML = '<table class="table table-bordered" id="sacadoTable"></table>';

        let contenedorBillete = document.querySelector("div[id=estadoBillete]");
        contenedorBillete.innerHTML = "";

        document.querySelector("#chanceCantidad").innerHTML = 0;
        document.querySelector("#tablePorcentajeCantidadChance").innerHTML = 0;
        document.querySelector("#chancePlata").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);
        document.querySelector("#tablePorcentajeChance").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);
        

        document.querySelector("#billeteCantidad").innerHTML = 0;
        document.querySelector("#tablePorcentajeCantidadBillete").innerHTML = 0;
        
        document.querySelector("#billetePlata").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);
        document.querySelector("#tablePorcentajeBillete").innerHTML = (
          Math.round(0 * 100) / 100
        ).toFixed(2);

        if (document.querySelectorAll(
          "#select-choose-game option"
        )[document.querySelector("#select-choose-game").selectedIndex].value){
          return
        } else {
          let numeroSorteo = document.querySelectorAll(
          "#select-choose-game option"
        )[document.querySelector("#select-choose-game").selectedIndex].value;
        }

        fetch(api + "sorteo/" + numeroSorteo + "/chances?ord=numero", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
          const table = document.getElementById("numberTable");
          const columns = 4;
          //Header
          const trheader = document.createElement("tr");
          const th = document.createElement("th");
          th.textContent = document.querySelectorAll("#select-choose-game option")[
            document.querySelector("#select-choose-game").selectedIndex
          ].text;
          th.setAttribute('colspan','8')
          trheader.appendChild(th)
          table.appendChild(trheader); 

          for (let row = 0; row < 25; row++) { // Crear 10 filas
              const tr = document.createElement("tr");
              for (let col = 0; col < columns; col++) { // Crear columnas para cada fila
