<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/images/espacio.png" type="image/png">
    <title><%= enviroment.VERSION %></title>
    <meta
      http-equiv="Content-Security-Policy"
      content="script-src 'self' 'unsafe-inline';"
    />
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css" />
    <link rel="stylesheet" href="/stylesheets/app.css" />
  </head>
  <body class="container-fluid" style="font-family: 'Roboto Mono', monospace;">
    <div
      class="d-none d-print-block print-style font-weight-bold pa"
      id="outDimention"
    >
      <div id="outPut1" class="pt-2"></div>
    </div>
    <div class="row d-print-none">
      <div
        class="col-2 mx-3 mt-2 card text-body p-2 text-black-50 mb-2"
        style="background-color: #dee2e6 !important"
        id="generar"
      >
        <div>
          <h5>Sorteo:</h5>
          <select
            id="select-choose-game"
            name="select-choose-game"
            type="text"
            class="custom-select"
          >
            <option value="" name="">Sin Sorteo Seleccionado</option>
          </select>
        </div>
        <h4 class="text-danger text-center pt-3" id="error-loading-game"></h4>
        <div class="rows" id="listaUsuarios"></div>
        <div class="rows">
          <div class="col-12 py-3">
            <button class="btn btn-sm btn-secondary col-12" id="btnActualizar">
              Actualizar
            </button>
          </div>
        </div>
        <div class="rows d-none">
          <div class="col-12 py-3">
            <button
              class="btn btn-sm btn-secondary col-12 "
              id="btnImprimirUnificado"
            >
              Imprimir
            </button>
          </div>
        </div>
        <div class="rows">
          <div class="col-12 py-3">
            <button class="btn btn-sm btn-secondary col-12" id="btnVentas">
              Regresar Venta
            </button>
          </div>
        </div>
      </div>
      <div class="col-4">
        <div class="card-border">
          <div class="col-12 text-center" id="estadoTitulo">
            <h5>Selecciona los usuarios del sorteo</h5>
          </div>
          <div class="d-flex" id="estado"></div>
          <div class="d-flex" id="estadoBillete"></div>
        </div>
      </div>
      <div class="col-4">
        <div class="d-flex card-border border-top-0" id="estadoSorteo">
          <div class="col-12 font-weight-bold my-2 d-none" id="totalSorteo">
            <div class="d-flex">
              <div class="col-12 card-border">Ventas</div>
            </div>
            <div class="d-flex">
              <div class="offset-4 col-4">Cantidad</div>
              <div class="col-4">Monto</div>
            </div>
            <div class="d-flex">
              <div class="col-4">Chance</div>
              <div class="col-4" id="chanceCantidad"></div>
              <div class="col-4" id="chancePlata"></div>
            </div>
            <div class="d-flex">
              <div class="col-4">Billete</div>
              <div class="col-4" id="billeteCantidad"></div>
              <div class="col-4" id="billetePlata"></div>
            </div>
            <div class="d-flex">
              <div class="col-8">Comision Chance</div>
              
              <div class="col-4" id="comisionChance"></div>
            </div>
            <div class="d-flex">
              <div class="col-8">Comision Billete</div>
              
              <div class="col-4" id="comisionBillete"></div>
            </div>
            <div class="d-flex">
              <div class="col-12 card-border">Cuentas de ganadores</div>
            </div>
            <div class="d-flex">
              <div class="col-4">Chance</div>
              <div class="offset-4 col-4" id="chancePremioTotal"></div>
            </div>
            <div class="d-flex">
              <div class="col-4">Billete</div>
              <div class="offset-4 col-4" id="BilletePremioTotal"></div>
            </div>
            <div class="d-flex">
              <div class="col-12 card-border">Diferencia</div>
            </div>
            <div class="d-flex">
              <div class="col-4">Chance</div>
              <div class="offset-4 col-4" id="chanceBalanceTotal"></div>
            </div>
            <div class="d-flex">
              <div class="col-4">Billete</div>
              <div class="offset-4 col-4" id="BilleteBalanceTotal"></div>
            </div>
          </div>
        </div>
        <div
          class="card text-body text-black-50"
          style="background-color: #dee2e6 !important"
          id="contenedorPorcentajes"
        ><div class="card-body">
          <table class="table table-bordered" id="porcentajeTable">
            <tr><th colspan="2">Venta Chances</th></tr>
            <tr><td class="font-weight-bold">Cantidad</td><td id="tablePorcentajeCantidadChance">0</td>
            <tr><td class="font-weight-bold">Monto</td><td id="tablePorcentajeChance">0</td>
            <tr><th colspan="2">Venta Billete</th></tr>
            <tr><td class="font-weight-bold">Cantidad</td><td id="tablePorcentajeCantidadBillete">0</td>
            <tr><td class="font-weight-bold">Monto</td><td id="tablePorcentajeBillete">0</td>
            <tr><th colspan="2">Vendedor</th></tr>
            <tr><td class="font-weight-bold">% Chances</td><td id="tablePorcentajeVendedorChance">0</td>
            <tr><td class="font-weight-bold">% Billetes</td><td id="tablePorcentajeVendedorBillete">0</td>
            <tr><td class="font-weight-bold">Total</td><td id="tablePorcentajeVendedorTotal">0</td>  
            <tr><th colspan="2">Casa</th></tr>
            <tr><td class="font-weight-bold">% Chances</td><td id="tablePorcentajeCasaChance">0</td>
            <tr><td class="font-weight-bold">% Billetes</td><td id="tablePorcentajeCasaBillete">0</td>
            <tr><td class="font-weight-bold">Total</td><td id="tablePorcentajeCasaTotal">0</td>
            <tr><th colspan="2">Ganadores</th></tr>
            <tr><td class="font-weight-bold">Chance</td><td id="tablePorcentajeGanadoresChance">0</td>
            <tr><td class="font-weight-bold">Billete</td><td id="tablePorcentajeGanadoresBillete">0</td>
            <tr><th colspan="2">Balance Sorteo</th></tr>
            <tr><td class="font-weight-bold">Chances</td><td id="tableBalanceChance">0</td>
            <tr><td class="font-weight-bold">Billetes</td><td id="tableBalanceBillete">0</td>
            <tr><td class="font-weight-bold">Total</td><td id="tableBalanceTotal">0</td>
          </table>
          </div>
        </div>
      </div>
    </div>

    <div
      class="alert alert-danger d-none offset-4 col-4 mt-5 p-5"
      role="alert"
      id="alertSession"
    >
      <h4 class="alert-heading">Su sesión caduco!</h4>
      <p>Oh si! debes ingresar nuevamente</p>
      <hr />
      <p class="mb-0" id="txtTimer">Seras redireccionado en 2 segundos . . .</p>
    </div>
    <div
      class="d-flex justify-content-center"
      style="margin-top: 20%"
      id="loading"
    >
      <div
        class="spinner-grow"
        role="status"
        style="
          width: 10rem;
          height: 10rem;
          background-color: #dee2e6 !important;
        "
        id="spinnerLog"
      >
        <span class="sr-only">Loading...</span>
      </div>
    </div>

    <script src="/javascripts/modules/output.js"></script>
    <script src="/javascripts/actions.js"></script>

    <script>
      var globalChance = {
        person: "Sorteo Unificado",
        id: "1234567899874566123",
        gameId: 0,
        receiptCount: "0",
        price: 0.25,
        bprice: 0,
        userId: 500,
        userProfile: "",
        userName: "",
        host: "192.168.0.10",
      };

      var api = "<%= enviroment.URL_API %>";

      /*Verificar si tiene sesión*/
      if (localStorage.getItem("tokenSSO")) {
        /*Verificando token*/
        fetch(api + "usuarios/decode", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.exitoso) {
              /**
               * Basado en el perfil mostrar o dejar de mostrar
               */
              localStorage.setItem("sesion-accesos", data.resultado.accesos);
              localStorage.setItem("sesion-perfil", data.resultado.perfil);
              localStorage.setItem("sesion-usuario", data.resultado.usuario);
              localStorage.setItem("sesion-id", data.resultado.id);
              localStorage.setItem("sesion-hijos", data.resultado.hijos);

              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
            } else {
              /**
               * Caduco la sesión mensaje y redireccionar
               */

              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#generar").classList.add("d-none");
              document
                .querySelector("#alertSession")
                .classList.remove("d-none");

              localStorage.removeItem("tokenSSO");
              setTimeout(function () {
                window.location = "/";
              }, 2000);
            }
          });
      } else {
        document.querySelector("#generar").classList.add("d-none");
        document.querySelector("#loading").classList.remove("d-flex");
        document.querySelector("#loading").classList.add("d-none");
        document.querySelector("#alertSession").classList.remove("d-none");
        localStorage.removeItem("tokenSSO");
        setTimeout(function () {
          window.location = "/";
        }, 2000);
      }

      /**
       * Carga automatica
       */

      cargarSorteos();

      function cargarSorteos() {
        fetch(api + "sorteo", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              let select = document.querySelector("#select-choose-game");
              while (select.length > 0) {
                select.remove(select.length - 1);
              }
              data.resultado.forEach((element) => {
                let option = document.createElement("option");
                option.text = element.nombre;
                option.value = element.id;
                option.setAttribute("name", element.id);
                select.add(option);
              });

              fetch(api + "sorteo/ultimo-cerrado", {
                method: "GET",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
                },
              })
                .then((response) => response.json())
                .then((element) => {
                  if (element.exitoso){
                    let select = document.querySelector("#select-choose-game");

                    //recorrer el arreglo
                    element.resultado.forEach(element => {
                      let option = document.createElement("option");
                      option.text = "Cerrado - "+element.nombre;
                      option.value = element.id;
                      option.setAttribute("name", element.id);
                      select.add(option);
                    });
                  }
                })
            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando sorteos, contacte el administrador.";
            }
            return;
          });
      }

      var arregloUsuarios = [];
      cargarUsuarios();
      function cargarUsuarios() {
        fetch(api + "usuarios", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            document.querySelector("#error-loading-game").innerHTML = "";
            if (data.exitoso) {
              arregloUsuarios = data.resultado;
              pintarUsuarios();
            } else {
              document.querySelector("#error-loading-game").innerHTML =
                "Error cargando usuarios, contacte el administrador.";
            }
            return;
          });
      }

      var bag = {
        person: globalChance.person,
        userId: globalChance.userId,
        id: () => {
          return globalChance.gameId
            .toString()
            .padStart(18, "0")
            .padStart(19, "1");
        },
        items: [],
        total: 0,
        date: function () {
          let date = new Date();
          return date.toLocaleString("en-US", { hour12: true });
        },
        receipt: () => {
          return Number(globalChance.receiptCount).toString().padStart(5, "0");
        },
        add: function (item) {
          this.items.push(item);
          this.calc();
          this.render();
        },
        update: function (index, item) {
          if (item.qty == 0) this.items.splice(index, 1);
          else {
            this.items[index].qty = item.qty;
            this.items[index].price = item.price;
            this.items[index].total = item.total;
          }
          this.calc();
          this.render();
        },
        render: chanceOutput,
        calc: function () {
          let sum = 0;
          this.items.forEach((element) => {
            sum += element.total;
          });
          this.total = (Math.round(sum * 100) / 100).toFixed(2);
        },
        clear: function () {
          this.items = [];
        },
        itemsInOrder: function () {
          let rows =
            this.items.length > 0
              ? this.items.sort(function compare(a, b) {
                  if (Number(a.number) < Number(b.number)) {
                    return -1;
                  }
                  if (Number(a.number) > Number(b.number)) {
                    return 1;
                  }
                  return 0;
                })
              : [];
          return rows;
        },
        type: function () {
          var isBillete = false;
          this.items.forEach(function (element) {
            isBillete = element.number.length > 2 ? true : false;
          });
          if (isBillete) {
            return "BILLETE";
          } else {
            return "CHANCE";
          }
        },
      };
      
      async function cargarInformacion() {
        try {

          //Cuentas Programacion
      var seleccionados = {
        chances: [],
        billetes: [],
        chancesTotal: 0.0,
        billetesTotal: 0.0,
        cantidadChances: 0,
        cantidadBilletes: 0,
      };
          var sorteoId = document
            .querySelectorAll("#select-choose-game option")
            [
              document.querySelector("#select-choose-game").selectedIndex
            ].getAttribute("name");

          var usuarios = "";

          document.querySelectorAll("#listaUsuarios input").forEach((check) => {
            if (check.checked) {
              usuarios = usuarios + ",";
              usuarios = usuarios + check.name;
            }
          });
          usuarios = usuarios.slice(1);

          if (usuarios.length == 0) {
            usuarios = localStorage.getItem("sesion-id")+","+ localStorage.getItem("sesion-hijos");
          }

          /*Buscando Chances del usuario*/
          fetch(api + "/sorteo/" + sorteoId + "/chances?only=" + usuarios, {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              document.querySelector("#error-loading-game").innerHTML = "";
              if (data.exitoso) {
                seleccionados.chances = data.resultado;
                let response = data.resultado;
                let builder = document.querySelector("#estado");
                builder.innerHTML = '<table class="table table-bordered" id="numberTable"></table>';
                
                const table = document.getElementById("numberTable");
                const columns = 4;
                //Header
                const trheader = document.createElement("tr");
                const th = document.createElement("th");
                th.textContent = document.querySelectorAll("#select-choose-game option")[
                  document.querySelector("#select-choose-game").selectedIndex
                ].text;
                th.setAttribute('colspan','8')
                trheader.appendChild(th)
                table.appendChild(trheader);

                for (let row = 0; row < 25; row++) { // Crear 10 filas
                    const tr = document.createElement("tr");
                    for (let col = 0; col < columns; col++) { // Crear columnas para cada fila
                        const td = document.createElement("td");
                        var cantidadIterable = 0;
                        const number = (col * 25 + row).toString().padStart(2, '0'); // Formatear número como "00", "01", etc.
                        td.textContent = number;
                        td.classList.add("font-weight-bold")
                        tr.appendChild(td);
                        
                        const tdCant = document.createElement("td");
                        tdCant.textContent = 0
                        tdCant.setAttribute('id','cc'+number.toString().padStart(2, 0))
                        tr.appendChild(tdCant);
                    }
                    table.appendChild(tr); // Añadir la fila a la tabla
                }

                response.forEach((element) => {
                  seleccionados.chancesTotal =
                    seleccionados.chancesTotal + element.dineroVenta;
                  seleccionados.cantidadChances =
                    seleccionados.cantidadChances + Number(element.cantidad);
                  chanceCantidad = document.querySelector("#tablePorcentajeCantidadChance");
                  chancePlata = document.querySelector("#tablePorcentajeChance");
                  chanceCantidad.innerHTML = seleccionados.cantidadChances;
                  chancePlata.innerHTML = (
                    Math.round(seleccionados.chancesTotal * 100) / 100
                  ).toFixed(2);
                  document.querySelector("#cc" + element.numero).innerHTML =
                    element.cantidad;
                });

                
                //Usuario sin venta
                if (response.length == 0) {
                  seleccionados.chancesTotal = 0
                  seleccionados.cantidadChances = 0
                  document.querySelector("#tablePorcentajeCantidadChance").innerHTML = 0;
                  document.querySelector("#tablePorcentajeChance").innerHTML = (
                    Math.round(0 * 100) / 100
                  ).toFixed(2);
                }

                //Comision Chance
                    //Si hay mas de uno seleccionado no calcula comision
                    let multipleSeleccionado = 0
                    let porcentajeVendedor = 0
                    document.querySelectorAll("#listaUsuarios input").forEach((check) => {
                      if (check.checked) {
                        multipleSeleccionado = multipleSeleccionado + 1
                        porcentajeVendedor = check.getAttribute("comision-chance")
                      }
                    });
                
                    console.log("seleccionados: "+multipleSeleccionado)
                if(multipleSeleccionado == 1) {
                  document.querySelector("#tablePorcentajeVendedorChance").innerHTML = (
                    Math.round(seleccionados.chancesTotal * Number(porcentajeVendedor) * 100) / 100
                  ).toFixed(2);
                  var porcentajeSeller = seleccionados.chancesTotal * Number(porcentajeVendedor)
                  var porcentajeCasa = seleccionados.chancesTotal  - porcentajeSeller
                  console.log("seleccionados: "+porcentajeCasa)
                  document.querySelector("#tablePorcentajeCasaChance").innerHTML = (
                    Math.round((porcentajeCasa) 
                    * 100) / 100
                  ).toFixed(2);

                } else {

                 //document.querySelector("#tablePorcentajeVendedorChance").innerHTML = "---.--"
                 //Si es principal entonces asignar 22% si es angelicab asignar 20%
                 if (localStorage.getItem("sesion-usuario") == "principal") {
                  porcentajeVendedor = 0.22

                    document.querySelector("#tablePorcentajeVendedorChance").innerHTML = (
                    Math.round(seleccionados.chancesTotal * Number(porcentajeVendedor) * 100) / 100
                  ).toFixed(2);
                  var porcentajeSeller = seleccionados.chancesTotal * Number(porcentajeVendedor)
                  var porcentajeCasa = seleccionados.chancesTotal  - porcentajeSeller
                  console.log("seleccionados: "+porcentajeCasa)
                  document.querySelector("#tablePorcentajeCasaChance").innerHTML = (
                    Math.round((porcentajeCasa) 
                    * 100) / 100
                  ).toFixed(2);


                  } else if (localStorage.getItem("sesion-usuario") == "AngelicaB") {
                    porcentajeVendedor = 0.20

                    document.querySelector("#tablePorcentajeVendedorChance").innerHTML = (
                    Math.round(seleccionados.chancesTotal * Number(porcentajeVendedor) * 100) / 100
                  ).toFixed(2);

                  var porcentajeSeller = seleccionados.chancesTotal * Number(porcentajeVendedor)
                  var porcentajeCasa = seleccionados.chancesTotal  - porcentajeSeller
                  console.log("seleccionados: "+porcentajeCasa)
                  document.querySelector("#tablePorcentajeCasaChance").innerHTML = (
                    Math.round((porcentajeCasa) 
                    * 100) / 100
                  ).toFixed(2);

                  } else {
                    document.querySelector("#tablePorcentajeVendedorChance").innerHTML = "---.--"

                  }


                }

              } else {
                document.querySelector("#error-loading-game").innerHTML =
                  "Error cargando chances en cuentas, contacte el administrador.";
              }

              return (
              Math.round((porcentajeCasa) 
              * 100) / 100
            ).toFixed(2);
              
            })
            .then((something => {
            /* Ganadores Chance*/
            fetch(api + "ganadores/" + sorteoId + "?accion=chance&only=" + usuarios, {
              method: "GET",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
              },
            })
              .then((response) => response.json())
              .then((totales) => {
                let cantidadTotal = 0;
                let montoTotal = 0;
                totales.resultado.forEach((elemento) => {
                  montoTotal = montoTotal + elemento.valorganador1er + elemento.valorganador2do
                    + elemento.valorganador3ro;
                });
                document.querySelector("#tablePorcentajeGanadoresChance").innerHTML = (
                  Math.round(montoTotal * 100) / 100
                ).toFixed(2);
                let balance = something - montoTotal
                if (balance < 0) {
                  document.querySelector("#tableBalanceChance").classList.add("text-danger");
                } else {
                  document.querySelector("#tableBalanceChance").classList.remove("text-danger");
                }
                //if (montoTotal == 0) {
                //  balance = "----.--";
                //}
                document.querySelector("#tableBalanceChance").innerHTML =
                (
                  Math.round(balance * 100) / 100
                ).toFixed(2) || 0;
              });
          }));

          /*Buscando Billetes del usuario*/
          fetch(api + "/sorteo/" + sorteoId + "/billetes?only=" + usuarios, {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              document.querySelector("#error-loading-game").innerHTML = "";
              if (data.exitoso) {
                seleccionados.billetes = data.resultado;
                //Comienza
                contenedorBillete = document.querySelector("div[id=estadoBillete]");
                contenedorBillete.innerHTML = '<table class="table table-bordered" id="billeteTable"></table>';
                const table = document.getElementById("billeteTable");
                const columns = 4;

                //Header
                const trheader = document.createElement("tr");
                const th = document.createElement("th");
                th.textContent = "Billetes"
                th.setAttribute('colspan','8')
                trheader.appendChild(th)
                table.appendChild(trheader); 

                const columnQty = data.resultado.length / 4 ;
                var number = 0
                for (let row = 0; row < columnQty; row++) {
                  if (number >= data.resultado.length)
                    continue;
                  const tr = document.createElement("tr");
                  for (let col = 0; col < columns; col++) { // Crear columnas para cada fila
                      if (number >= data.resultado.length)
                        continue;
                      const td = document.createElement("td");
                      var cantidadIterable = 0;
                      //const number = (col * columnQty + row).toString().padStart(2, '0'); // Formatear número como "00", "01", etc.
                      td.textContent = data.resultado[number].numero;
                      td.classList.add("font-weight-bold")
                      tr.appendChild(td);

                      const tdCant = document.createElement("td");
                      tdCant.textContent = data.resultado[number].cantidad
                      tr.appendChild(tdCant);

                      //calculo
                      seleccionados.billetesTotal =
                      seleccionados.billetesTotal + data.resultado[number].dineroVenta;
                      seleccionados.cantidadBilletes =
