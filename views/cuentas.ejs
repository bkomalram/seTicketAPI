      function convergerDatos() {
        seleccionados.chances = [];
        seleccionados.billetes = [];
        seleccionados.chancesTotal = 0.0;
        seleccionados.billetesTotal = 0.0;
        seleccionados.cantidadChances = 0;
        seleccionados.cantidadBilletes = 0;

        /*Chances*/
        document.querySelectorAll("input").forEach((check) => {
          if (check.checked) {
            if (seleccionados.chances.length === 0) {
              arregloUsuarios[check.value].chances.forEach((registro) => {
                seleccionados.chances.push(registro);
              });
            } else {
              for (
                let index = 0;
                index < arregloUsuarios[check.value].chances.length;
                index++
              ) {
                let chanceOperando =
                  arregloUsuarios[check.value].chances[index];
                let existeEnBase = seleccionados.chances.filter(
                  (registro) =>
                    registro.CHANCE === chanceOperando.CHANCE &&
                    chanceOperando.CANTIDAD > 0
                );
                if (existeEnBase.length > 0) {
                  var indexExistente = seleccionados.chances.indexOf(
                    existeEnBase[0]
                  );
                  var nuevoElemento = {
                    CHANCE: chanceOperando.CHANCE,
                    CANTIDAD:
                      existeEnBase[0].CANTIDAD + chanceOperando.CANTIDAD,
                  };

                  seleccionados.chances.splice(
                    indexExistente,
                    1,
                    nuevoElemento
                  );
                }
              }
            }

            /*Totales*/
            seleccionados.chancesTotal =
              seleccionados.chancesTotal +
              Number(arregloUsuarios[check.value].plataChances);
            seleccionados.cantidadChances =
              seleccionados.cantidadChances +
              Number(arregloUsuarios[check.value].cantidadChances);
          }
        });

        /*Billetes*/
        document.querySelectorAll("input").forEach((check) => {
          if (check.checked) {
            if (seleccionados.billetes.length === 0) {
              arregloUsuarios[check.value].billetes.forEach((registro) => {
                seleccionados.billetes.push(registro);
              });
            } else {
              for (
                let index = 0;
                index < arregloUsuarios[check.value].billetes.length;
                index++
              ) {
                let billeteOperando =
                  arregloUsuarios[check.value].billetes[index];
                let existeEnBase = seleccionados.billetes.filter(
                  (registro) => registro.NUMERO === billeteOperando.NUMERO
                );
                if (existeEnBase.length > 0) {
                  var indexExistente = seleccionados.billetes.indexOf(
                    existeEnBase[0]
                  );
                  var nuevoElemento = {
                    NUMERO: billeteOperando.NUMERO,
                    CANTIDAD:
                      existeEnBase[0].CANTIDAD + billeteOperando.CANTIDAD,
                  };

                  seleccionados.billetes.splice(indexExistente, 1);
                  seleccionados.billetes.push(nuevoElemento);
                } else {
                  seleccionados.billetes.push(billeteOperando);
                }
              }
            }
            /*Totales*/
            seleccionados.billetesTotal =
              seleccionados.billetesTotal +
              Number(arregloUsuarios[check.value].plataBilletes);
            seleccionados.cantidadBilletes =
              seleccionados.cantidadBilletes +
              Number(arregloUsuarios[check.value].cantidadBilletes);
          }
        });

        /*Pintar*/
        pintarCuentas();
      }

      function pintarCuentas() {
        let response = seleccionados.chances;
        let builder = document.querySelector("div[id=estado]");
        builder.innerHTML = "";
        document.querySelector("#estadoTitulo").innerHTML =
          "<h5>" +
          document.querySelectorAll("#select-choose-game option")[
            document.querySelector("#select-choose-game").selectedIndex
          ].text +
          "</h5>";
        let html = "";
        response.forEach((element) => {
          html +=
            '<div class="d-flex"><b class="mr-3">' +
            element.CHANCE +
            "</b>" +
            '<p class="mb-0">' +
            element.CANTIDAD +
            "</p></div>";
          if ([24, 49, 74, 99].indexOf(Number(element.CHANCE)) > -1) {
            builder.innerHTML += '<div class="col-3 py-1">' + html + "</div>";
            html = "";
          }
        });

        response = seleccionados.billetes;

        builder = document.querySelector("div[id=estadoBillete]");
        builder.innerHTML = "";
        html = "";
        var count = 0;
        var base = response.length < 20 ? response.length / 4 : 20;
        response.forEach((element) => {
          html +=
            '<div class="d-flex"><b class="mr-3">' +
            element.NUMERO +
            "</b>" +
            '<p class="mb-0">' +
            element.CANTIDAD +
            "</p></div>";
          count += 1;
          if (count % base == 0) {
            builder.innerHTML += '<div class="col-3 py-1">' + html + "</div>";
            html = "";
          }
        });

        chanceCantidad = document.querySelector("div[id=chanceCantidad]");
        chancePlata = document.querySelector("div[id=chancePlata]");

        billeteCantidad = document.querySelector("div[id=billeteCantidad]");
        billetePlata = document.querySelector("div[id=billetePlata]");

        chanceCantidad.innerHTML = seleccionados.cantidadChances;
        chancePlata.innerHTML = (
          Math.round(seleccionados.chancesTotal * 100) / 100
        ).toFixed(2);

        billeteCantidad.innerHTML = seleccionados.cantidadBilletes;
        billetePlata.innerHTML = (
          Math.round(seleccionados.billetesTotal * 100) / 100
        ).toFixed(2);
      }

