<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title><%= enviroment.VERSION %></title>
    <meta
      http-equiv="Content-Security-Policy"
      content="script-src 'self' 'unsafe-inline';"
    />
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css" />
    <link rel="stylesheet" href="/stylesheets/app.css" />
  </head>
  <body class="container-fluid">
    <div class="row d-print-none mt-5">
      <div
        class="card p-5 text-black-50 offset-4 col-4 mt-5"
        style="background-color: #dee2e6 !important"
      >
        <div class="row">
          <h1 class="card-title"><%= enviroment.TITLE %></h1>
        </div>
        <form id="form-login">
          <h3>Usuario:</h3>
          <input
            type="text"
            class="form-control col-12"
            id="username"
            autocomplete="off"
          />

          <h3>Contraseña:</h3>
          <input
            type="password"
            class="form-control"
            id="password"
            autocomplete="off"
          />

          <button
            class="btn btn-secondary col-12 mt-3"
            type="submit"
            id="btnLog"
          >
            <h4 id="txtLog">Entrar</h4>
            <div class="spinner-grow d-none" role="status" id="spinnerLog">
              <span class="sr-only">Loading...</span>
            </div>
          </button>
        </form>
        <h4 class="text-danger text-center pt-3" id="txtError"></h4>
      </div>
    </div>
    <script>
      var api = "<%= enviroment.URL_API %>";

      /*Verificar si tiene sesión*/
      if (localStorage.getItem("tokenSSO")) {
        window.location = "/ventas";
      }

      /*Colocando token inicial*/
      fetch(api + "usuarios/token")
        .then((response) => response.json())
        .then((data) => {
          localStorage.setItem("tokenInit", data.token);
        });

      document
        .querySelector("#form-login")
        .addEventListener("submit", function (event) {
          event.preventDefault();
          document.querySelector("#txtLog").classList.add("d-none");
          document.querySelector("#spinnerLog").classList.remove("d-none");
          document.querySelector("#txtError").innerHTML = "";

          let usuario = document.querySelector("#username").value
            ? document.querySelector("#username").value
            : "";
          let password = document.querySelector("#password").value
            ? document.querySelector("#password").value
            : "";
          var data = {
            usuario: usuario,
            password: password,
          };
          fetch(api + "usuarios/log", {
            method: "POST",
            body: JSON.stringify(data),
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenInit"),
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.exitoso) {
                localStorage.setItem("tokenSSO", data.resultado.token);
                return true;
              } else {
                document.querySelector("#password").value = "";
                document.querySelector("#txtError").innerHTML = data.resultado;
              }
              document.querySelector("#spinnerLog").classList.add("d-none");
              document.querySelector("#txtLog").classList.remove("d-none");
            })
            .then((data) => {
              if (data) {
                window.location = "/ventas";
              }
            });
        });
    </script>
  </body>
</html>
