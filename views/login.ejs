<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/lucky-clover.svg" type="image/svg+xml" />
    <title><%= enviroment.VERSION %></title>
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline';" />
    <link rel="stylesheet" href="/stylesheets/login.css" />
    <link rel="stylesheet" href="/stylesheets/theme.css" />
    <script src="/javascripts/theme.js"></script>
  </head>
  <body>
    <main class="login-layout">
      <section class="login-card" aria-labelledby="login-title">
        <div class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5Z"/><path d="M15 5v3m0 3v2m0 3v3"/></svg></span><span><%= enviroment.TITLE %></span></div>
        <header>
          <p class="eyebrow">BIENVENIDO DE NUEVO</p>
          <h1 id="login-title">Inicia sesión</h1>
          <p class="intro">Ingresa tus datos para continuar.</p>
        </header>
        <form id="form-login">
          <div class="field">
            <label for="username">Usuario</label>
            <input type="text" id="username" name="username" placeholder="Tu nombre de usuario" autocomplete="username" autocapitalize="none" spellcheck="false" required />
          </div>
          <div class="field">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Tu contraseña" autocomplete="current-password" required />
          </div>
          <p class="error" id="txtError" role="alert" aria-live="polite"></p>
          <button type="submit" id="btnLog"><span id="txtLog">Entrar</span><span id="spinnerLog" class="spinner" hidden aria-hidden="true"></span><svg class="button-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
        </form>
      </section>
      <footer>Tu gestión, en un solo lugar.</footer>
    </main>
    <script>
      var api = "<%= enviroment.URL_API %>";
      if (localStorage.getItem("tokenSSO")) window.location = "/ventas";

      const form = document.querySelector("#form-login");
      const button = document.querySelector("#btnLog");
      const label = document.querySelector("#txtLog");
      const spinner = document.querySelector("#spinnerLog");
      const error = document.querySelector("#txtError");
      function getInitialToken() {
        return fetch(api + "usuarios/token")
          .then(response => { if (!response.ok) throw new Error(); return response.json(); })
          .then(data => { if (!data.token) throw new Error(); localStorage.setItem("tokenInit", data.token); return data.token; });
      }
      const initialToken = getInitialToken().catch(() => null);
      form.addEventListener("submit", async function (event) {
        event.preventDefault();
        if (button.disabled) return;
        button.disabled = true;
        button.setAttribute("aria-busy", "true");
        label.textContent = "Ingresando…";
        spinner.hidden = false;
        error.textContent = "";
        try {
          const token = await initialToken || await getInitialToken();
          const response = await fetch(api + "usuarios/log", {
            method: "POST",
            body: JSON.stringify({ usuario: document.querySelector("#username").value, password: document.querySelector("#password").value }),
            headers: { "Content-Type": "application/json", Authorization: "Bearer " + token }
          });
          if (!response.ok) throw new Error();
          const data = await response.json();
          if (data.exitoso) {
            localStorage.setItem("tokenSSO", data.resultado.token);
            window.location = "/ventas";
            return;
          }
          document.querySelector("#password").value = "";
          error.textContent = data.resultado || "Revisa tu usuario y contraseña.";
          document.querySelector("#password").focus();
        } catch (_) {
          error.textContent = "No pudimos conectar. Inténtalo de nuevo.";
        }
        button.disabled = false;
        button.removeAttribute("aria-busy");
        label.textContent = "Entrar";
        spinner.hidden = true;
      });
    </script>
  </body>
</html>
