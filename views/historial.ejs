<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Historial de Ventas</title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css" />
    <link rel="stylesheet" href="/stylesheets/app.css" />
    <link rel="icon" href="/images/espacio.png" type="image/png" />
    <link rel="stylesheet" href="/stylesheets/desktop.css" />
    <link rel="stylesheet" href="/stylesheets/historial.css" />
    <link rel="stylesheet" href="/stylesheets/modals.css" />
  </head>
  <body class="container-fluid sales-page history-page">
    <div id="history-workspace">
      <header class="workspace-header"><div class="workspace-brand"><span class="workspace-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5Z"/><path d="M15 5v3m0 3v2m0 3v3"/></svg></span><span><%= enviroment.TITLE %></span><span class="workspace-divider"></span><span class="workspace-section">Historial</span></div><button class="btn btn-secondary" id="btn-back"><span id="text-back">Regresar a ventas</span><span class="spinner-grow spinner-grow-sm d-none" id="spinner-back" role="status"><span class="sr-only">Cargando…</span></span></button></header>
      <div class="workspace-intro"><div><p class="workspace-eyebrow">CONSULTA TUS VENTAS</p><h1>Historial de ventas</h1></div><p>Revisa los tickets del sorteo seleccionado.</p></div>
      <section class="history-card">
        <div class="history-panel-heading"><div><h2>Tickets vendidos</h2><p>Consulta el detalle o administra tus tickets.</p></div><span class="winner-legend"><span aria-hidden="true"></span>Ticket ganador</span></div>
        <p id="history-status" role="status" aria-live="polite">Cargando historial…</p>
        <div class="table-responsive">
          <table class="table table-bordered table-hover table-sm mb-0" id="tablaTickets">
            <thead class="thead-light">
              <tr>
                <th scope="col">Ticket</th>
                <th scope="col">Monto total</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <!-- Aquí se llenarán los tickets -->
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <div class="d-flex justify-content-center d-none" id="loading">
      <div class="spinner-grow" role="status" style="width: 5rem; height: 5rem; background-color: #dee2e6 !important;">
        <span class="sr-only">Loading...</span>
      </div>
    </div>
    <script>

      document.getElementById('btn-back').addEventListener('click', function() {
        window.location = "/ventas";
      });

      document.getElementById('loading').classList.remove('d-none');
      const api = "<%= enviroment.URL_API %>";
      const token = localStorage.getItem("tokenSSO");
      const usuario = localStorage.getItem("sesion-id");
      const identificadorJuego = localStorage.getItem("choose-game");
      /*Verificar si tiene sesión*/
      // Check if user is logged in
      if (!localStorage.getItem("tokenSSO")) {
        window.location = "/";
      }


      fetch(api + "/tiquete?users=" + usuario + "&game=" + identificadorJuego, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
        },
      })
        .then((response) => response.json())
        .then((data) => {
          
          document.getElementById('loading').classList.add('d-none');
          if (data.exitoso) {
            const status = document.getElementById('history-status');
            status.textContent = 'No hay tickets para este sorteo.';
            status.hidden = data.resultado.length > 0;
            const tbody = document.querySelector("#tablaTickets tbody");
            tbody.innerHTML = "";
            data.resultado.forEach(ticket => {
              const tr = document.createElement("tr");
              var tdBGcolor = "";
              //Si ticket.ganador es "SI" colocar color verde a tr
              if (ticket.ganador === "SI") {
                tr.classList.add("winning-ticket");
                tdBGcolor = "class='winning-cell'";
              }

              tr.innerHTML = `
                <td ${tdBGcolor}>${ticket.id}</td>
                <td ${tdBGcolor}>${Number(ticket.valorcompra).toFixed(2)}</td>
                <td ${tdBGcolor}>
                  <div class="d-flex flex-wrap flex-md-nowrap justify-content-end align-items-center ticket-actions">
                    <button class="btn btn-sm btn-secondary mb-1 mb-md-0 me-1" style="min-width:36px;" onclick="editarTicket('${ticket.id}')" title="Editar">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                      </svg>
                    <span class="action-label">Editar</span></button>
                    <button class="btn btn-sm btn-danger mb-1 mb-md-0 me-1" style="min-width:36px;" onclick="eliminarTicket('${ticket.id}')" title="Eliminar">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                      </svg>
                    <span class="action-label">Eliminar</span></button>
                    <button class="btn btn-sm btn-info mb-1 mb-md-0" style="min-width:36px;" onclick="verTicket('${ticket.id}')" title="Ver">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
                      </svg>
                    <span class="action-label">Ver</span></button>
                  </div>
                </td>
              `;
              tbody.appendChild(tr);
            });
          } else {
            document.getElementById('history-status').textContent = 'No pudimos cargar los tickets. Recarga la página para intentarlo de nuevo.';
            document.getElementById('history-status').classList.add('history-error');
          }
        }).catch(() => {
          document.getElementById('loading').classList.add('d-none');
          document.getElementById('history-status').textContent = 'No pudimos conectar. Recarga la página para intentarlo de nuevo.';
          document.getElementById('history-status').classList.add('history-error');
        });
      function editarTicket(id) {
        // Guardar el ID del ticket en localStorage para mantenerlo entre páginas
        localStorage.setItem('ticketToEdit', id);
        // Redirigir a la página de venta
        window.location.href = '/ventas';
      }

      // Si venimos de la página de venta, limpiar el ticket guardado
      window.onload = function() {
        if (window.location.pathname === '/historial') {
          localStorage.removeItem('ticketToEdit');
        }
      }
      function eliminarTicket(id) {

        //obtener el ticket a eliminar para confirmar que es posible eliminar
        fetch(api + "tiquete/"+id+"?accion=editar", {
            method: "GET",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
            },
          })
          .then((response) => response.json())
          .then((data) => {
            if (data.resultado.length < 1) {
              alert('No se puede eliminar el ticket');
            } else {
              
              if (confirm('¿Seguro que deseas eliminar el ticket ' + id + '?')) {
                fetch(api + "/tiquete", {
                  method: "PATCH",
                  headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + token,
                  },
                  body: JSON.stringify({ tiqueteId: id })
                })
                  .then((response) => response.json())
                  .then((data) => {
                    if (data.exitoso) {
                      alert('Ticket eliminado');
                      location.reload();
                    } else {
                      alert('No se pudo eliminar el ticket');
                    }
                  });
              }
            }
          });
      }
    </script>
    <!-- Modal para ver información del ticket -->
    <div class="modal fade" id="modalVerTicket" tabindex="-1" role="dialog" aria-labelledby="modalVerTicketLabel" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalVerTicketLabel">Información del Ticket</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar" onclick="cerrarModalVerTicket()">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body" id="modalVerTicketBody">
            <!-- Aquí se llenará la información del ticket -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="cerrarModalVerTicket()">Cerrar</button>
          </div>
        </div>
      </div>
    </div>

    <script>
      function verTicket(id) {
        // Mostrar spinner en el modal mientras carga
        document.getElementById('modalVerTicketBody').innerHTML = '<div class="text-center"><div class="spinner-border" role="status"><span class="sr-only">Cargando...</span></div></div>';
        mostrarModalVerTicket();
        fetch(api + "/tiquete/" + id, {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.exitoso && data.resultado) {
              let tickets = Array.isArray(data.resultado) ? data.resultado : [data.resultado];
              let html = '';
              html += `<div class="table-responsive"><table class="table table-bordered table-sm mb-0">
                <thead class="thead-light">
                  <tr>
                    <th>Premio</th>
                    <th>Número</th>
                    <th>Cantidad</th>
                    <th>Total</th>
                    <th>Fecha</th>
                  </tr>
                </thead>
                <tbody>`;
              tickets.forEach(ticket => {
                let fecha = ticket.createdAt ? new Date(ticket.createdAt).toLocaleString() : '';
                let calcularPremio = ticket.ganador === "SI" ? (ticket.valorganador1er + ticket.valorganador2do + ticket.valorganador3ro).toFixed(2) : '0.00';

                var tdBGcolor = "";
              //Si ticket.ganador es "SI" colocar color verde a tr
              if (ticket.ganador === "SI") {
                tdBGcolor = "class='winning-cell'";
              }

                html += `<tr>
                  <td ${tdBGcolor}>${calcularPremio || ''}</td>
                  <td ${tdBGcolor}>${ticket.numero || ''}</td>
                  <td ${tdBGcolor}>${ticket.cantidad || ''}</td>
                  <td ${tdBGcolor}>$${ticket.valorcompra != null ? Number(ticket.valorcompra).toFixed(2) : ''}</td>
                  <td ${tdBGcolor}>${fecha}</td>
                </tr>`;
              });
              html += `</tbody></table></div>`;
              document.getElementById('modalVerTicketBody').innerHTML = html;
              document.getElementById('modalVerTicketLabel').innerHTML = 'Información del Ticket - ' + (tickets.length > 0 ? id : '');
            } else {
              document.getElementById('modalVerTicketBody').innerHTML = '<div class="alert alert-danger">No se pudo cargar la información del ticket.</div>';
            }
          })
          .catch(() => {
            document.getElementById('modalVerTicketBody').innerHTML = '<div class="alert alert-danger">Error al consultar el ticket.</div>';
          });
      }

      // Funciones para mostrar y cerrar el modal
      function mostrarModalVerTicket() {
        const modal = document.getElementById('modalVerTicket');
        modal.classList.add('show');
        modal.style.display = 'block';
        modal.removeAttribute('aria-hidden');
        modal.setAttribute('aria-modal', 'true');
        document.body.classList.add('modal-open');
        // Agregar backdrop manualmente
        if (!document.getElementById('modalVerTicket-backdrop')) {
          const backdrop = document.createElement('div');
          backdrop.className = 'modal-backdrop fade show';
          backdrop.id = 'modalVerTicket-backdrop';
          document.body.appendChild(backdrop);
        }
      }
      function cerrarModalVerTicket() {
        const modal = document.getElementById('modalVerTicket');
        modal.classList.remove('show');
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
        modal.removeAttribute('aria-modal');
        document.body.classList.remove('modal-open');
        // Quitar backdrop manualmente
        const backdrop = document.getElementById('modalVerTicket-backdrop');
        if (backdrop) {
          backdrop.parentNode.removeChild(backdrop);
        }
      }
    </script>
  </body>
</html>
