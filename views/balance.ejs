<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/espacio.png" type="image/png">
    <title><%= enviroment.VERSION %></title>
    <meta
      http-equiv="Content-Security-Policy"
      content="script-src 'self' 'unsafe-inline';"
    />
    <link rel="stylesheet" href="/stylesheets/bootstrap.min.css" />
    <link rel="stylesheet" href="/stylesheets/app.css" />
    <link rel="stylesheet" href="/stylesheets/desktop.css" />
    <link rel="stylesheet" href="/stylesheets/balance.css" />
    <link rel="stylesheet" href="/stylesheets/theme.css" />
    <script src="/javascripts/theme.js"></script>
  </head>
  <body class="container-fluid sales-page balance-page">
    <main class="d-print-none" id="generar">
      <header class="workspace-header"><div class="workspace-brand"><span class="workspace-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4V5Z"/><path d="M15 5v3m0 3v2m0 3v3"/></svg></span><span><%= enviroment.TITLE %></span><span class="workspace-divider"></span><span class="workspace-section">Balance</span></div><button class="btn btn-secondary" id="btnVentas">Regresar a ventas</button></header>
      <div class="workspace-intro"><div><p class="workspace-eyebrow">RESUMEN DE PREMIOS</p><h1>Balance</h1></div><p>Consulta los premios pendientes de canje por sorteo.</p></div>
      <div class="balance-metrics">
        <section class="balance-card metric-primary"><p>Total pendiente</p><strong id="balance-total">—</strong><span>Premios por canjear</span></section>
        <section class="balance-card"><p>Sorteos con premios pendientes</p><strong id="balance-count">—</strong><span>Incluidos en esta consulta</span></section>
      </div>
      <section class="balance-card" id="balance-card" aria-labelledby="balance-title">
        <div class="balance-panel-heading"><div><h2 id="balance-title">Detalle por sorteo</h2><p>Importes pendientes de tus usuarios y tu cuenta.</p></div><button type="button" class="btn btn-secondary" id="refresh-balance">Actualizar</button></div>
        <p id="balance-status" role="status" aria-live="polite">Cargando balance…</p>
        <div class="balance-table-wrap" id="balance-table-wrap" hidden><table><thead><tr><th scope="col">Sorteo</th><th scope="col">Premios pendientes</th></tr></thead><tbody id="balance-sorteos"></tbody></table></div>
      </section>
    </main>

    <div
      class="alert alert-danger d-none offset-4 col-4 mt-5 p-5"
      role="alert"
      id="alertSession"
    >
      <h4 class="alert-heading">Su sesión caduco!</h4>
      <p>Oh si! debes ingresar nuevamente</p>
      <hr />
      <p class="mb-0" id="txtTimer">Seras redireccionado en 2 segundos . . .</p>
    </div>
    <div
      class="d-flex justify-content-center"
      style="margin-top: 20%"
      id="loading"
    >
      <div
        class="spinner-grow"
        role="status"
        style="
          width: 10rem;
          height: 10rem;
          background-color: #dee2e6 !important;
        "
        id="spinnerLog"
      >
        <span class="sr-only">Loading...</span>
      </div>
    </div>
    <script>
      var api = "<%= enviroment.URL_API %>";
      var qrURL = "<%= enviroment.URL_QR %>";

      /*Verificar si tiene sesión*/
      if (localStorage.getItem("tokenSSO")) {
        /*Verificando token*/
        fetch(api + "usuarios/decode", {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + localStorage.getItem("tokenSSO"),
          },
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.exitoso) {
              /**
               * Basado en el perfil mostrar o dejar de mostrar
               */
              localStorage.setItem("sesion-accesos", data.resultado.accesos);
              localStorage.setItem("sesion-perfil", data.resultado.perfil);
              localStorage.setItem("sesion-usuario", data.resultado.usuario);
              localStorage.setItem("sesion-id", data.resultado.id);
              localStorage.setItem("sesion-hijos", data.resultado.hijos);
              
              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#generar").classList.remove("d-none");
              loadBalance();
            } else {
              /**
               * Caduco la sesión mensaje y redireccionar
               */

              document.querySelector("#loading").classList.remove("d-flex");
              document.querySelector("#loading").classList.add("d-none");
              document.querySelector("#generar").classList.add("d-none");
              document
                .querySelector("#alertSession")
                .classList.remove("d-none");

              localStorage.removeItem("tokenSSO");
              setTimeout(function () {
                window.location = "/";
              }, 2000);
            }
          });
      } else {
        document.querySelector("#generar").classList.add("d-none");
        document.querySelector("#loading").classList.remove("d-flex");
        document.querySelector("#loading").classList.add("d-none");
        document.querySelector("#alertSession").classList.remove("d-none");
        localStorage.removeItem("tokenSSO");
        setTimeout(function () {
          window.location = "/";
        }, 2000);
      }

      /**
       * Carga automatica
       */
      async function loadBalance() {
        const button = document.getElementById('refresh-balance');
        if (button.disabled) return;
        const status = document.getElementById('balance-status');
        const table = document.getElementById('balance-table-wrap');
        const body = document.getElementById('balance-sorteos');
        const total = document.getElementById('balance-total');
        const count = document.getElementById('balance-count');
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.textContent = 'Actualizando…';
        status.hidden = false;
        status.textContent = 'Cargando balance…';
        status.classList.remove('balance-error');
        table.hidden = true;
        total.textContent = '—';
        count.textContent = '—';
        try {
          const users = [localStorage.getItem('sesion-id'), localStorage.getItem('sesion-hijos')].filter(Boolean).join(',');
          const response = await fetch(api + 'ganadores?only=' + encodeURIComponent(users), {
            headers: { Authorization: 'Bearer ' + localStorage.getItem('tokenSSO') }
          });
          if (!response.ok) throw new Error();
          const data = await response.json();
          if (!data.exitoso || !Array.isArray(data.resultado)) throw new Error();
          const rows = data.resultado.slice().sort((a, b) => Number(a.gameId) - Number(b.gameId));
          body.textContent = '';
          let sum = 0;
          const format = new Intl.NumberFormat('es-PA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          rows.forEach(item => {
            const amount = Number(item.total);
            if (!Number.isFinite(amount)) throw new Error();
            sum += amount;
            const row = document.createElement('tr');
            const name = document.createElement('td');
            const value = document.createElement('td');
            name.textContent = item.gameName;
            value.textContent = format.format(amount);
            row.appendChild(name);
            row.appendChild(value);
            body.appendChild(row);
          });
          total.textContent = format.format(sum);
          count.textContent = String(rows.length);
          status.textContent = 'No hay premios pendientes de canje.';
          status.hidden = rows.length > 0;
          table.hidden = rows.length === 0;
        } catch (error) {
          status.textContent = 'No pudimos cargar el balance. Pulsa Actualizar para intentarlo de nuevo.';
          status.classList.add('balance-error');
        } finally {
          button.disabled = false;
          button.removeAttribute('aria-busy');
          button.textContent = 'Actualizar';
        }
      }
      document.getElementById('refresh-balance').addEventListener('click', loadBalance);

          document
        .querySelector("#btnVentas")
        .addEventListener("click", function (event) {
          window.location = "/ventas";
        });
    </script>
  </body>
</html>
